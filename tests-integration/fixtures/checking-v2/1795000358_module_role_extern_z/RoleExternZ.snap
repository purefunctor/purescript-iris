  N :: Int -> N
  U :: forall (@a :: Type). Z a -> U a
  direct :: Z Int -> Z N
  viaU :: U Int -> U N

Errors

Tree
  coerce :: forall (a :: Type) (b :: Type). Coercible @Type a b => a -> b
    abstract [a#5, b#6] [d0 : Coercible @Type a#5 b#6]
    coerce  = (unsafeCoerce @[a#5, b#6] {})
  direct :: Z Int -> Z N
    abstract [] []
    direct  = (coerce @[Z Int, Z N] {builtin Coercible Empty})
  viaU :: U Int -> U N
