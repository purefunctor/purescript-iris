module EscConstraint

Types
  ST :: Type -> Type -> Type
  Ref :: Type -> Type -> Type
  Shw :: Type -> Type -> Constraint

Roles
  ST nominal nominal
  Ref nominal nominal

Terms
  newRef :: forall (r :: Type) (a :: Type). a -> ST r (Ref r a)
  run :: forall (a :: Type). (forall (r :: Type). ST r a) -> a
  coerce :: forall (a :: Type) (b :: Type). a -> b
  sh :: forall (r :: Type) (a :: Type) (b :: Type). Shw a b => ST r a -> ST r b
  leak :: forall (t15 :: Type). Shw (Ref r#14 Int) t15 => t15

Errors
  [leak] EscapedSkolem: r#14 in forall (t15 :: Type). Shw (Ref r#14 Int) t15 => t15

Tree
  sh :: forall (r :: Type) (a :: Type) (b :: Type). Shw a b => ST r a -> ST r b
    abstract [r#11, a#12, b#13] [d0 : Shw a#12 b#13]
    sh  = (coerce @[ST r#11 a#12, ST r#11 b#13] {})
  leak :: forall (t15 :: Type). Shw (Ref r#14 Int) t15 => t15
    abstract [t15] [d1 : Shw (Ref r#14 Int) t15]
    leak  = ((run @[t15] {}) (Λ[r#14] []. ((sh @[r#14, Ref r#14 Int, t15] {d1}) ((newRef @[r#14, Int] {}) 1))))
