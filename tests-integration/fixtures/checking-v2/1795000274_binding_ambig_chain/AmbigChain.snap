module AmbigChain

Types
  Shw :: Type -> Constraint
  F :: Type -> Type -> Constraint

Roles

Terms
  shw :: forall (@a :: Type). Shw a => a -> String
  fget :: forall (@a :: Type) (@b :: Type). F a b => a -> b
  k :: forall (a :: Type) (b :: Type). a -> b -> a
  test :: forall (t7 :: Type) (t8 :: Type) (t9 :: Type). Shw t8 => F t9 t8 => F t7 t9 => t7 -> t7

Errors

Tree
  k :: forall (a :: Type) (b :: Type). a -> b -> a
    abstract [a#5, b#6] []
    k (x :: a#5) (_ :: b#6) = x
  test :: forall (t7 :: Type) (t8 :: Type) (t9 :: Type). Shw t8 => F t9 t8 => F t7 t9 => t7 -> t7
    abstract [t7, t8, t9] [d0 : Shw t8, d1 : F t9 t8, d2 : F t7 t9]
    test (x :: t7) = (((k @[t7, String] {}) x) ((shw @[t8] {d0}) ((fget @[t9, t8] {d1}) ((fget @[t7, t9] {d2}) x))))
