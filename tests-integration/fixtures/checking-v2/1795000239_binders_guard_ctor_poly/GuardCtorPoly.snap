module GuardCtorPoly

Types
  Maybe :: Type -> Type

Roles
  Maybe representational

Terms
  Just :: forall (@a :: Type). a -> Maybe a
  Nothing :: forall (@a :: Type). Maybe a
  poly :: forall (a :: Type). Maybe a
  add :: Int -> Int -> Int
  t :: Int -> Int

Errors

Tree
  t :: Int -> Int
    abstract [] []
    t (n :: Int) | (Just (x :: Int) :: Maybe Int) <- (poly @[Int] {}) = ((add n) x)
    t (n :: Int) = n
