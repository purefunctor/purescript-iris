=== width 80, indent 2 ===
module Main where

plain value = result
  where
  result = value

guarded value
  | predicate value = first
  | otherwise = second
    where
    first = 1
    second = 2

monadic = do
  action
  where
  helper = 1

helperOnly = 1
  where
  helper = do
    action

=== width 100, indent 4, unicode ===
module Main where

plain value = result
    where
    result = value

guarded value
    | predicate value = first
    | otherwise = second
        where
        first = 1
        second = 2

monadic = do
    action
    where
    helper = 1

helperOnly = 1
    where
    helper = do
        action
