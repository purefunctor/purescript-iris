module Main where

top =
    let
        y = 1
    in
        do
            action y

statement = do
    x ←
        let
            y = 1
        in
            do
                action y
    pure x

branches value =
    case value of
        A →
            let
                y = 1
            in
                do
                    action y
        B →
            if condition
            then do
                firstAction
                secondAction
            else fallback

conditional =
    if condition
    then do
        action
    else fallback

binding =
    let
        y = do
            action
    in
        y

empty = ado
    {- before the result -}
    in 1

emptyLine = ado
    -- before the result
    in 2
