module Main where

type Tail =
  ( | VeryLongRowTypeConstructorName
        firstArgument
        secondArgument
        thirdArgument
        fourthArgument
  )
type Fields =
  ( field :: Int
  | VeryLongRowTypeConstructorName
      firstArgument
      secondArgument
      thirdArgument
      fourthArgument
  )
type RecordTail =
  { | VeryLongRowTypeConstructorName
        firstArgument
        secondArgument
        thirdArgument
        fourthArgument
  }
type CommentTail =
  ( field :: Int
  | -- tail comment
    VeryLongRowTypeConstructorName
      firstArgument
      secondArgument
      thirdArgument
      fourthArgument
  )

