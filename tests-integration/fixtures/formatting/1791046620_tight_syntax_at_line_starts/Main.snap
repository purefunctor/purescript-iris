=== width 120, indent 2 ===
module Main where

main =
  traverse_
    (\item -> log ("processing " <> show item <> " of " <> show (Array.length items) <> " in the current batch"))
    (Array.range firstIndex lastIndex)

terms = do
  (r.a)
  (_.a)
  (-1)
  (h @b)
  ({ a: 1 })
  ( ( a do
        b
    )
  )

patterns value = case value of
  [ -1 ] -> 0
  _ -> 1

rows :: forall firstRow secondRow. { | firstRow } -> { | secondRow } -> { | firstRow } -> Int
quantified :: (forall value. value -> value) -> (forall value. value -> value) -> Int
