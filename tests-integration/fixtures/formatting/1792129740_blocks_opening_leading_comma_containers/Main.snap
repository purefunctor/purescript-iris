module Main where

argument = use
    [ do
          action
    , nextArgument
    ]
    finalArgument

updateEffect =
    record
        { field = do
              action
        , otherField = secondArgument
        }
widePrefix = use "界界界界"
    { field: do
          action
    , otherField: secondArgument
    }
