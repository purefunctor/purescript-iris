=== width 80, indent 2 ===
module Main where

effect = do
  [ do
      firstAction
  , ado
      value <- secondAction
      in value
  ]
  { result:
      case input of
        Just value -> value
        Nothing -> fallback
  , local:
      let
        value = firstArgument
      in
        value
  , choice: if condition then firstArgument else secondArgument
  }
  finalAction

argument = use
  [ do
      action
  , nextArgument
  ] finalArgument

patterns first second =
  case first, second of
    { firstField: value, secondField: other }, [ item, rest ] -> value
    _, _ -> fallback

named whole@{ firstField: value, secondField: other } = whole
lambda = \{ firstField: value, secondField: other } -> value

patternLocal = result
  where
  { firstField: result, secondField: other } = source

doLocal = do
  let
    { firstField: result, secondField: other } = source
  pure result

type Tail row = { | row }
type RowTail row = (| row)
data Wrapped = Wrapped { firstField :: FirstType, secondField :: SecondType }

literal =
  [ """first
second"""
  , { nested: [ { value: firstArgument }, { value: secondArgument } ] }
  ]

updateEffect = record
  { field = do
      action
  , otherField = secondArgument
  }
qualifiedUpdate =
  M.record { field = firstArgument, otherField = secondArgument }
accessUpdate =
  record.field { field = firstArgument, otherField = secondArgument }
parenthesizedUpdate =
  (chooseRecord firstArgument)
    { field = firstArgument, otherField = secondArgument }
sectionUpdate = _ { field = firstArgument, otherField = secondArgument }
widePrefix = use "界界界界"
  { field: do
      action
  , otherField: secondArgument
  }
