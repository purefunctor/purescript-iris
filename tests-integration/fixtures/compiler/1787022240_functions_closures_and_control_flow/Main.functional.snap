@export apply = \function%0 value%1 -> function%0 value%1

@export capture = \captured%3 -> \$int%2@(_) -> captured%3

@export choose = \condition%4 left%5 right%6 ->
  if condition%4 then left%5 else right%6

@export partial = choose true 42

@export literalCase = \value%7 ->
  case value%7 of
    0 ->
      "zero"
    _ ->
      "other"

@export higherOrder = apply (capture 42) 0
