@export foreign record

@export foreign takeLog

@export statementWhen = \flag%1 ->
  effect.bind (effect.newReference 0)
    \ref%0 -> effect.bind (if flag%1 then effect.writeReference 5 ref%0 else effect.pure unit)
      \$unit%2 -> effect.bind (if boolean.not flag%1
        then effect.modifyReference (\section87%3 -> integer.add section87%3 1) ref%0
        else effect.pure unit)
        \$unit%4 -> effect.readReference ref%0

@export finalWhen = \flag%6 ->
  effect.bind (record "before") \$unit%5 -> when applicativeEffect flag%6 (record "inside")

@export stateUnless = \count%7 ->
  uncurried.call effect.bind (effect.newReference count%7)
    \ref%8 -> effect.bind (if boolean.not (integer.greater_than count%7 0)
      then effect.void (effect.writeReferenceValue 0 ref%8)
      else effect.pure unit)
      \$unit%9 -> effect.readReference ref%8()
