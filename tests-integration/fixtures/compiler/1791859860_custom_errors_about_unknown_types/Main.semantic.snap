failsWithUnknown :: Prim.TypeError.Fail (Prim.TypeError.Quote @?[cannot apply function type] Main.Invalid) => Prim.Int
failsWithUnknown = \{failDict} -> 0

usesFailsWithUnknown :: Prim.Int
usesFailsWithUnknown = failsWithUnknown {error}

failsIndependently :: Prim.TypeError.Fail (Prim.TypeError.Text "independent failure") => Prim.Int
failsIndependently = \{failDict} -> 0

usesFailsIndependently :: Prim.Int
usesFailsIndependently = failsIndependently {error}

warnsWithUnknown :: Prim.TypeError.Warn (Prim.TypeError.Quote @?[cannot apply function type] Main.Invalid) => Prim.Int
warnsWithUnknown = \{warnDict} -> 0

usesWarnsWithUnknown :: Prim.Int
usesWarnsWithUnknown = warnsWithUnknown {trivial}

warnsIndependently :: Prim.TypeError.Warn (Prim.TypeError.Text "independent warning") => Prim.Int
warnsIndependently = \{warnDict} -> 0

usesWarnsIndependently :: Prim.Int
usesWarnsIndependently = warnsIndependently {trivial}
