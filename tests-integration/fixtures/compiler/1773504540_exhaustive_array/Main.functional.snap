---
source: tests-integration/src/fixtures.rs
---
@export testNonExhaustive = \$array%0 ->
  case $array%0 of
    [] ->
      0
    [x%1] ->
      x%1

@export testRedundant = \$array%2 ->
  case $array%2 of
    [x%3] ->
      x%3
    [y%4] ->
      y%4
    _ ->
      0

@export testExhaustive = \$array%5 ->
  case $array%5 of
    [] ->
      0
    [x%6] ->
      x%6
    _ ->
      0
