        \$unit%7 -> effect.bind (effect.while
          (effect.map
            (\section107%8 -> integer.less_than section107%8 20)
            (effect.readReference total%0))
          (effect.modifyReference (\section126%9 -> integer.add section126%9 4) total%0))
          \$unit%10 -> effect.bind (effect.until
