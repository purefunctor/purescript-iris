data Tagged :: Prim.Type
data Tagged
  | Tagged :: { hyphen-label :: Prim.Int } -> Main.Tagged

foreign import await :: Prim.Int

arguments :: Prim.Int
arguments = await

default :: { hyphen-label :: Prim.Int }
default = { hyphen-label: arguments }

readLabel :: { hyphen-label :: Prim.Int } -> Prim.Int
