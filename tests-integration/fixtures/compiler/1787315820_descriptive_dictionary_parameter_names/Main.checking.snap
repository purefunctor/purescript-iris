distinctEqual ::
  forall left right.
    Main.Equal left =>
    Main.Equal right =>
    left -> left -> right -> right -> { left :: Prim.Boolean, right :: Prim.Boolean }
duplicateEqual ::
  forall value. Main.Equal value => Main.Equal value => value -> value -> Prim.Boolean
parameterCollision ::
  forall value. Main.Equal value => Prim.Boolean -> value -> value -> Prim.Boolean
