data Unit :: Prim.Type
data Unit
  | Unit :: Main.Unit

data Use1 :: Prim.Type -> Prim.Type
data Use1 @hooks

data Use2 :: Prim.Type -> Prim.Type
data Use2 @hooks

foreign import pure :: forall hooks a. a -> Main.Render hooks hooks a

foreign import discard :: forall a b x y z. Main.Render x y a -> (a -> Main.Render y z b) -> Main.Render x z b

foreign import use1 :: forall hooks. Main.Render hooks (Main.Use1 hooks) Main.Unit

foreign import use2 :: forall hooks. Main.Render hooks (Main.Use2 hooks) Main.Unit

test :: Main.Render Main.Start (Main.Use2 (Main.Use1 Main.Start)) Main.Unit
test = discard use1 \_ -> discard use2 \_ -> pure Unit
