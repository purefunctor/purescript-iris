const :: forall @a @b. a -> b -> a
const = \a -> \_ -> a

choose :: Prim.Int -> (forall @a @b. a -> b -> a)
choose = \_ -> \a -> \_ -> a

normal :: forall t0 t1. { parenthesised :: t0 -> t1 -> t0 }
normal = { parenthesised: const }

prenex :: { application :: forall @a @b. a -> b -> a, variable :: Prim.Int -> (forall @a @b. a -> b -> a) }
