@export performPure = \value%0 -> unsafePerformEffect (effect.pure (integer.add value%0 1))

@export runPure = \value%1 -> run (effect.pure (integer.multiply value%1 2))

@export runReference = \value%2 -> run (effect.bind (new value%2) \bindValue%3 -> read bindValue%3)
