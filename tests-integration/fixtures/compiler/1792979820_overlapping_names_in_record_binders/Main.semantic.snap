punAndArgument :: { x :: Prim.Int } -> Prim.Int -> Prim.Int
punAndArgument = \{ x } -> \x -> x

punAndField :: { a :: Prim.Int, x :: Prim.Int } -> Prim.Int
punAndField = \{ a: x, x } -> x

fields :: { a :: Prim.Int, b :: Prim.Int } -> Prim.Int
fields = \{ a: x, b: x } -> x
