compareArrays :: Prim.Array Prim.Int -> Prim.Array Prim.Int -> Prim.Boolean
compareArrays = \left -> \right ->
  if eq {eqArray {eqInt}} left right then eq {eqArray {eqInt}} right left else false

initialized :: Prim.Boolean
initialized = compareArrays [1] [1]
