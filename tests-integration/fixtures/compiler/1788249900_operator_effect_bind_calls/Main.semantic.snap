---
source: tests-integration/src/fixtures.rs
---
foreign import equalInt :: Prim.Int -> Prim.Int -> Prim.Boolean

foreign import decrementInt :: Prim.Int -> Prim.Int

namedContinuation :: Data.Unit.Unit -> Effect.Effect Prim.Int
namedContinuation = \_ -> pure {applicativeEffect} 42

namedBind :: Data.Unit.Unit -> Effect.Effect Prim.Int
namedBind = \_ -> bind {bindEffect} (pure {applicativeEffect} unit) namedContinuation

tailBind :: Prim.Int -> Effect.Effect Prim.Int
tailBind = \value ->
  if equalInt value 0 then
    pure {applicativeEffect} value
  else
    bind {bindEffect} (pure {applicativeEffect} unit) \_ -> tailBind (decrementInt value)
