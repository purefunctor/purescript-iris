  compare :: Main.Compose @Prim.Type @t0 f g a -> Main.Compose @Prim.Type @t0 f g a -> Data.Ordering.Ordering
  compare = \left right ->
    case left, right of
      (Compose left0), (Compose right0) ->
        case compare1 {ord1Dict} {ordDict} left0 right0 of
          EQ -> EQ
          ordering -> ordering

