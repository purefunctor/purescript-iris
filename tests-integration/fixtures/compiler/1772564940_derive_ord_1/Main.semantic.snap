data Id :: Prim.Type -> Prim.Type
data Id @a
  | Id :: a -> Main.Id a

data Wrap :: forall k0. (k0 -> Prim.Type) -> k0 -> Prim.Type
data Wrap @f @a
  | Wrap :: f a -> Main.Wrap f a

data Compose :: forall k0 k1. (k0 -> Prim.Type) -> (k1 -> k0) -> k1 -> Prim.Type
data Compose @f @g @a
  | Compose :: f (g a) -> Main.Compose f g a

data NoOrd :: Prim.Type -> Prim.Type
data NoOrd @a
  | NoOrd :: a -> Main.NoOrd a

dictionary eqId :: forall a. { eqDict :: Data.Eq.Eq a } => Data.Eq.Eq (Main.Id a) where
  eq :: Main.Id a -> Main.Id a -> Prim.Boolean
  eq = \left right ->
    case left, right of
      (Id left0), (Id right0) ->
        if eq {eqDict} left0 right0 then true else false

dictionary eq1Id :: Data.Eq.Eq1 Main.Id where
  eq1 :: forall a. Data.Eq.Eq a => Main.Id a -> Main.Id a -> Prim.Boolean
  eq1 = \{eqDict} -> eq {eqId {eqDict}}

dictionary ordId :: forall a. { ordDict :: Data.Ord.Ord a } => Data.Ord.Ord (Main.Id a) where
  superclass eqDict = eqId {ordDict.eqDict}
  compare :: Main.Id a -> Main.Id a -> Data.Ordering.Ordering
  compare = \left right ->
    case left, right of
      (Id left0), (Id right0) ->
        case compare {ordDict} left0 right0 of
          EQ -> EQ
          ordering -> ordering

dictionary ord1Id :: Data.Ord.Ord1 Main.Id where
  superclass eq1Dict = eq1Id
  compare1 :: forall a. Data.Ord.Ord a => Main.Id a -> Main.Id a -> Data.Ordering.Ordering
  compare1 = \{ordDict} -> compare {ordId {ordDict}}

dictionary eqWrapType ::
  forall f a.
  { eq1Dict :: Data.Eq.Eq1 f } =>
  { eqDict :: Data.Eq.Eq a } =>
  Data.Eq.Eq (Main.Wrap @Prim.Type f a)
  where
  eq :: Main.Wrap @Prim.Type f a -> Main.Wrap @Prim.Type f a -> Prim.Boolean
  eq = \left right ->
    case left, right of
      (Wrap left0), (Wrap right0) ->
        if eq1 {eq1Dict} {eqDict} left0 right0 then true else false

dictionary eq1WrapType ::
  forall f.
  { eq1Dict :: Data.Eq.Eq1 f } =>
  Data.Eq.Eq1 (Main.Wrap @Prim.Type f)
  where
  eq1 :: forall a. Data.Eq.Eq a => Main.Wrap @Prim.Type f a -> Main.Wrap @Prim.Type f a -> Prim.Boolean
  eq1 = \{eqDict} -> eq {eqWrapType {eq1Dict} {eqDict}}

dictionary ordWrapType ::
  forall f a.
  { ord1Dict :: Data.Ord.Ord1 f } =>
  { ordDict :: Data.Ord.Ord a } =>
  Data.Ord.Ord (Main.Wrap @Prim.Type f a)
  where
  superclass eqDict = eqWrapType {ord1Dict.eq1Dict} {ordDict.eqDict}
  compare :: Main.Wrap @Prim.Type f a -> Main.Wrap @Prim.Type f a -> Data.Ordering.Ordering
  compare = \left right ->
    case left, right of
      (Wrap left0), (Wrap right0) ->
        case compare1 {ord1Dict} {ordDict} left0 right0 of
          EQ -> EQ
          ordering -> ordering

dictionary ord1WrapType ::
  forall f.
  { ord1Dict :: Data.Ord.Ord1 f } =>
  Data.Ord.Ord1 (Main.Wrap @Prim.Type f)
  where
  superclass eq1Dict = eq1WrapType {ord1Dict.eq1Dict}
  compare1 :: forall a.
  Data.Ord.Ord a => Main.Wrap @Prim.Type f a -> Main.Wrap @Prim.Type f a -> Data.Ordering.Ordering
  compare1 = \{ordDict} -> compare {ordWrapType {ord1Dict} {ordDict}}

dictionary eqComposeType ::
  forall f t0 g a.
  { eq1Dict :: Data.Eq.Eq1 f } =>
  { eqDict :: Data.Eq.Eq (g a) } =>
  Data.Eq.Eq (Main.Compose @Prim.Type @t0 f g a)
  where
  eq :: Main.Compose @Prim.Type @t0 f g a -> Main.Compose @Prim.Type @t0 f g a -> Prim.Boolean
  eq = \left right ->
    case left, right of
      (Compose left0), (Compose right0) ->
        if eq1 {eq1Dict} {eqDict} left0 right0 then true else false

