Compose :: forall t0 t1. (t0 -> Prim.Type) -> (t1 -> t0) -> t1 -> Prim.Type
Reader :: Prim.Type -> Prim.Type -> Prim.Type
NestedReader :: Prim.Type -> Prim.Type -> Prim.Type -> Prim.Type
Cont :: Prim.Type -> Prim.Type -> Prim.Type
Record :: Prim.Type -> Prim.Type
OpenRecord :: Prim.Row Prim.Type -> Prim.Type -> Prim.Type

