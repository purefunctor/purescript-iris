Terms
Identity :: forall @a. a -> Main.Identity a
Const :: forall t0 @e (@a :: t0). e -> Main.Const @t0 e (a :: t0)
Nothing :: forall @a. Main.Maybe a
Just :: forall @a. a -> Main.Maybe a
Wrap ::
  forall t0 (@f :: t0 -> Prim.Type) (@a :: t0).
    (f :: t0 -> Prim.Type) (a :: t0) -> Main.Wrap @t0 (f :: t0 -> Prim.Type) (a :: t0)
Compose ::
  forall t0 t1 (@f :: t0 -> Prim.Type) (@g :: t1 -> t0) (@a :: t1).
    (f :: t0 -> Prim.Type) ((g :: t1 -> t0) (a :: t1)) ->
    Main.Compose @t0 @t1 (f :: t0 -> Prim.Type) (g :: t1 -> t0) (a :: t1)
Reader :: forall @r @a. (r -> a) -> Main.Reader r a
NestedReader :: forall @r @s @a. (r -> s -> a) -> Main.NestedReader r s a
Cont :: forall @r @a. ((a -> r) -> r) -> Main.Cont r a
Record :: forall @a. { changed :: a, fixed :: Prim.Int } -> Main.Record a
OpenRecord ::
  forall (@r :: Prim.Row Prim.Type) @a.
    { changed :: a | (r :: Prim.Row Prim.Type) } -> Main.OpenRecord (r :: Prim.Row Prim.Type) a

