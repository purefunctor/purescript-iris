data Proxy :: forall k. k -> Prim.Type
data Proxy @a
  | Proxy :: Main.Proxy a

consOpen :: forall r row.
  Prim.Row.Cons @Prim.Type "x" Prim.Int ( a :: Prim.String | r ) row =>
  Main.Proxy @(Prim.Row Prim.Type) row
consOpen = \{consDict} -> Proxy

decomposeOpen :: forall t tail r.
  Prim.Row.Cons @Prim.Type "x" t tail ( a :: Prim.String, x :: Prim.Int | r ) =>
  Main.Proxy @Prim.Type t
decomposeOpen = \{consDict} -> Proxy

extractTail :: forall tail r.
  Prim.Row.Cons @Prim.Type "x" Prim.Int tail ( a :: Prim.String, x :: Prim.Int | r ) =>
  Main.Proxy @(Prim.Row Prim.Type) tail
extractTail = \{consDict} -> Proxy

forceSolve :: forall t0 t1.
  { consOpen :: Main.Proxy @(Prim.Row Prim.Type) ( a :: Prim.String, x :: Prim.Int | t0 )
  , decomposeOpen :: Main.Proxy @Prim.Type Prim.Int
  , extractTail :: Main.Proxy @(Prim.Row Prim.Type) ( a :: Prim.String | t1 )
  }
forceSolve =
  { consOpen: consOpen {trivial}, decomposeOpen: decomposeOpen {trivial}, extractTail: extractTail {trivial} }
