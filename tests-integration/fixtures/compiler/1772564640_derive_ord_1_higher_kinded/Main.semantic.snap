data Wrap :: forall k0. (k0 -> Prim.Type) -> k0 -> Prim.Type
data Wrap @f @a
  | MkWrap :: f a -> Main.Wrap f a

data WrapNoOrd1 :: forall k0. (k0 -> Prim.Type) -> k0 -> Prim.Type
data WrapNoOrd1 @f @a
  | MkWrapNoOrd1 :: f a -> Main.WrapNoOrd1 f a

dictionary eqWrapType ::
  forall f a.
  { eq1Dict :: Data.Eq.Eq1 f } =>
  { eqDict :: Data.Eq.Eq a } =>
  Data.Eq.Eq (Main.Wrap @Prim.Type f a)
  where
  eq :: Main.Wrap @Prim.Type f a -> Main.Wrap @Prim.Type f a -> Prim.Boolean
  eq = \left right ->
    case left, right of
      (MkWrap left0), (MkWrap right0) ->
        if eq1 {eq1Dict} {eqDict} left0 right0 then true else false

dictionary ordWrapType ::
  forall f a.
  { ord1Dict :: Data.Ord.Ord1 f } =>
  { ordDict :: Data.Ord.Ord a } =>
  Data.Ord.Ord (Main.Wrap @Prim.Type f a)
  where
  superclass eqDict = eqWrapType {ord1Dict.eq1Dict} {ordDict.eqDict}
  compare :: Main.Wrap @Prim.Type f a -> Main.Wrap @Prim.Type f a -> Data.Ordering.Ordering
  compare = \left right ->
    case left, right of
      (MkWrap left0), (MkWrap right0) ->
        case compare1 {ord1Dict} {ordDict} left0 right0 of
          EQ -> EQ
          ordering -> ordering

dictionary eqWrapNoOrd1Type ::
  forall f a.
  { eq1Dict :: Data.Eq.Eq1 f } =>
  { eqDict :: Data.Eq.Eq a } =>
  Data.Eq.Eq (Main.WrapNoOrd1 @Prim.Type f a)
  where
  eq :: Main.WrapNoOrd1 @Prim.Type f a -> Main.WrapNoOrd1 @Prim.Type f a -> Prim.Boolean
  eq = \left right ->
    case left, right of
      (MkWrapNoOrd1 left0), (MkWrapNoOrd1 right0) ->
        if eq1 {eq1Dict} {eqDict} left0 right0 then true else false
