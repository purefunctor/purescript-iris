foreign import makeContinuation :: Data.Unit.Unit -> Data.Unit.Unit -> Effect.Effect Prim.Int

localBind :: Data.Unit.Unit -> Effect.Effect Prim.Int
localBind = \_ ->
  let
    continuation :: Data.Unit.Unit -> Effect.Effect Prim.Int
    continuation = makeContinuation unit
  in
    bind {bindEffect} (pure {applicativeEffect} unit) continuation
