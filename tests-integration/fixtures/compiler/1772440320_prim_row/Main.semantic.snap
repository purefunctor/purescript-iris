solveUnion :: forall t0.
  { deriveUnion :: Type.Proxy.Proxy @(Prim.Row Prim.Type) ( a :: Prim.Int, b :: Prim.String )
  , deriveUnionLeft :: Type.Proxy.Proxy @(Prim.Row Prim.Type) ( a :: Prim.Int )
  , deriveUnionRight :: Type.Proxy.Proxy @(Prim.Row Prim.Type) ( b :: Prim.String )
  , unionBothEmpty :: Type.Proxy.Proxy @(Prim.Row t0) ()
  , unionEmptyLeft :: Type.Proxy.Proxy @(Prim.Row Prim.Type) ( a :: Prim.Int )
  , unionEmptyRight :: Type.Proxy.Proxy @(Prim.Row Prim.Type) ( a :: Prim.Int )
  , unionMultiple ::
      Type.Proxy.Proxy @(Prim.Row Prim.Type) ( a :: Prim.Int, b :: Prim.String, c :: Prim.Boolean )
  }
solveUnion =
  { deriveUnion: deriveUnion {trivial}, deriveUnionLeft: deriveUnionLeft {trivial}, deriveUnionRight: deriveUnionRight {trivial}, unionEmptyLeft: unionEmptyLeft {trivial}, unionEmptyRight: unionEmptyRight {trivial}, unionBothEmpty: unionBothEmpty {trivial}, unionMultiple: unionMultiple {trivial} }

solveCons :: { deriveCons :: Type.Proxy.Proxy @(Prim.Row Prim.Type) ( name :: Prim.String )
, deriveTail :: Type.Proxy.Proxy @(Prim.Row Prim.Type) ( age :: Prim.Int )
, deriveType :: Type.Proxy.Proxy @Prim.Type Prim.String
, nestedCons :: Type.Proxy.Proxy @(Prim.Row Prim.Type) ( a :: Prim.Int, b :: Prim.String )
}
solveCons =
  { deriveCons: deriveCons {trivial}, deriveTail: deriveTail {trivial}, deriveType: deriveType {trivial}, nestedCons: nestedCons {trivial} }

solveLacks :: forall t0 t1 t2 t3.
  { lacksEmpty :: Type.Proxy.Proxy @t0 t1, lacksSimple :: Type.Proxy.Proxy @t2 t3 }
solveLacks = { lacksSimple: lacksSimple {trivial} Proxy, lacksEmpty: lacksEmpty {trivial} Proxy }

solveNub :: forall t0.
  { nubEmpty :: Type.Proxy.Proxy @(Prim.Row t0) ()
  , nubNoDuplicates :: Type.Proxy.Proxy @(Prim.Row Prim.Type) ( a :: Prim.Int, b :: Prim.String )
  }
solveNub = { nubNoDuplicates: nubNoDuplicates {trivial}, nubEmpty: nubEmpty {trivial} }
