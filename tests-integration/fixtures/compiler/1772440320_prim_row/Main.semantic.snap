lacksSimple = \{lacksDict} -> \x -> x

lacksEmpty :: forall t0 t1 r. Prim.Row.Lacks @t1 "anything" () => Type.Proxy.Proxy @t0 r -> Type.Proxy.Proxy @t0 r
