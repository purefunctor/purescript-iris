data Predicate :: Prim.Type -> Prim.Type
data Predicate @a
  | Predicate :: (a -> Prim.Boolean) -> Main.Predicate a

data UnaryContravariant :: Prim.Type -> Prim.Type
data UnaryContravariant @a
  | UnaryContravariant :: Main.Predicate a -> Main.UnaryContravariant a

data Box :: Prim.Type -> Prim.Type
data Box @a
  | Box :: a -> Main.Box a

data UnaryCovariant :: Prim.Type -> Prim.Type
data UnaryCovariant @a
  | UnaryCovariant :: Main.Box (a -> Prim.Boolean) -> Main.UnaryCovariant a

data Pair :: Prim.Type -> Prim.Type -> Prim.Type
data Pair @a @b
  | Pair :: a -> b -> Main.Pair a b

data BinaryFirst :: Prim.Type -> Prim.Type
data BinaryFirst @a
  | BinaryFirst :: Main.Pair (a -> Prim.Boolean) Prim.Int -> Main.BinaryFirst a

data BinarySecond :: Prim.Type -> Prim.Type
data BinarySecond @a
  | BinarySecond :: Main.Pair Prim.Int (a -> Prim.Boolean) -> Main.BinarySecond a

data BinaryBoth :: Prim.Type -> Prim.Type
data BinaryBoth @a
  | BinaryBoth :: Main.Pair (a -> Prim.Boolean) (a -> Prim.String) -> Main.BinaryBoth a

data FunctionLike :: Prim.Type -> Prim.Type -> Prim.Type
data FunctionLike @a @b
  | FunctionLike :: (a -> b) -> Main.FunctionLike a b

data NestedProfunctor :: Prim.Type -> Prim.Type -> Prim.Type
data NestedProfunctor @a @b
  | NestedProfunctor :: Main.FunctionLike a b -> Main.NestedProfunctor a b

dictionary contravariantPredicate :: Data.Functor.Contravariant.Contravariant Main.Predicate where
  cmap :: forall a b. (b -> a) -> Main.Predicate a -> Main.Predicate b
  cmap = \function value ->
    case value of
      (Predicate field0) -> Predicate \argument -> field0 (function argument)

dictionary contravariantUnaryContravariant ::
  Data.Functor.Contravariant.Contravariant Main.UnaryContravariant
  where
  cmap :: forall a b. (b -> a) -> Main.UnaryContravariant a -> Main.UnaryContravariant b
  cmap = \function value ->
    case value of
      (UnaryContravariant field0) -> UnaryContravariant
        (cmap {contravariantPredicate} (\element -> function element) field0)

dictionary functorBox :: Data.Functor.Functor Main.Box where
  map :: forall a b. (a -> b) -> Main.Box a -> Main.Box b
  map = \function value ->
    case value of
      (Box field0) -> Box (function field0)

dictionary contravariantUnaryCovariant ::
  Data.Functor.Contravariant.Contravariant Main.UnaryCovariant
  where
  cmap :: forall a b. (b -> a) -> Main.UnaryCovariant a -> Main.UnaryCovariant b
  cmap = \function value ->
    case value of
      (UnaryCovariant field0) -> UnaryCovariant
        (map {functorBox} (\element -> \argument -> element (function argument)) field0)

dictionary bifunctorPair :: Data.Bifunctor.Bifunctor Main.Pair where
  bimap :: forall a b c d. (a -> b) -> (c -> d) -> Main.Pair a c -> Main.Pair b d
  bimap = \firstFunction secondFunction value ->
    case value of
      (Pair field0 field1) -> Pair (firstFunction field0) (secondFunction field1)

dictionary functorPair :: forall a. Data.Functor.Functor (Main.Pair a) where
  map :: forall a1 b. (a1 -> b) -> Main.Pair a a1 -> Main.Pair a b
  map = \function value ->
    case value of
      (Pair field0 field1) -> Pair field0 (function field1)

dictionary contravariantBinaryFirst :: Data.Functor.Contravariant.Contravariant Main.BinaryFirst
  where
  cmap :: forall a b. (b -> a) -> Main.BinaryFirst a -> Main.BinaryFirst b
  cmap = \function value ->
    case value of
      (BinaryFirst field0) -> BinaryFirst
        (bimap {bifunctorPair} (\element -> \argument -> element (function argument))
          (\unchanged -> unchanged)
          field0)

dictionary contravariantBinarySecond :: Data.Functor.Contravariant.Contravariant Main.BinarySecond
  where
  cmap :: forall a b. (b -> a) -> Main.BinarySecond a -> Main.BinarySecond b
  cmap = \function value ->
    case value of
      (BinarySecond field0) -> BinarySecond
        (map {functorPair} (\element -> \argument -> element (function argument)) field0)

dictionary contravariantBinaryBoth :: Data.Functor.Contravariant.Contravariant Main.BinaryBoth where
  cmap :: forall a b. (b -> a) -> Main.BinaryBoth a -> Main.BinaryBoth b
  cmap = \function value ->
    case value of
      (BinaryBoth field0) -> BinaryBoth
        (bimap {bifunctorPair} (\element -> \argument -> element (function argument))
          (\element -> \argument -> element (function argument))
          field0)

dictionary profunctorFunctionLike :: Data.Profunctor.Profunctor Main.FunctionLike where
  dimap :: forall a b c d. (a -> b) -> (c -> d) -> Main.FunctionLike b c -> Main.FunctionLike a d
  dimap = \firstFunction secondFunction value ->
    case value of
      (FunctionLike field0) -> FunctionLike \argument ->
        secondFunction (field0 (firstFunction argument))

dictionary profunctorNestedProfunctor :: Data.Profunctor.Profunctor Main.NestedProfunctor where
  dimap :: forall a b c d. (a -> b) -> (c -> d) -> Main.NestedProfunctor b c -> Main.NestedProfunctor a d
  dimap = \firstFunction secondFunction value ->
    case value of
      (NestedProfunctor field0) -> NestedProfunctor
        (dimap {profunctorFunctionLike} (\element -> firstFunction element)
          (\element -> secondFunction element)
          field0)
