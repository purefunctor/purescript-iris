data Maybe :: Prim.Type -> Prim.Type
data Maybe @a
  | Just :: a -> Main.Maybe a
  | Nothing :: Main.Maybe a

interface Unwrap :: Prim.Type -> Prim.Constraint
interface Unwrap a where
  unwrap :: Prim.Partial => a -> Prim.Int

dictionary unwrapMaybe :: Main.Unwrap (Main.Maybe Prim.Int) where
  unwrap :: Prim.Partial => Main.Maybe Prim.Int -> Prim.Int
  unwrap = \{partialDict} -> \choice ->
    let
      (Just value) = choice
    in
      value

foreign import unsafePartial :: forall a. (Prim.Partial => a) -> a

discharged :: Main.Maybe Prim.Int -> Prim.Int
discharged = unsafePartial \{partialDict} -> unwrap {unwrapMaybe} {partialDict}
