@export sharedIntegerAdd = \left%2 right%3 ->
  let
    total%1 = integer.add left%2 right%3
  in \value%0 -> integer.add total%1 value%0

@export sharedRecord = \value%6 ->
  let
    record%5 = { value: value%6 }
  in \$unit%4@(_) -> record%5

@export directUse = \left%8 right%9 -> integer.multiply (integer.add left%8 right%9) 2

@export branchUse = \flag%10 left%12 right%13 ->
  if flag%10 then integer.add left%12 right%13 else 0
