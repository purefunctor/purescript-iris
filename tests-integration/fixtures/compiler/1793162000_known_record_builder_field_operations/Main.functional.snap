@export insertFlipped = \record%0 ->
  build
    (composeFlipped semigroupoidBuilder
      (insert <trivial evidence> <trivial evidence> (symbol "y") "Proxy" "y")
      (insert <trivial evidence> <trivial evidence> (symbol "z") "Proxy" true))
    record%0

@export insertComposed = \record%1 ->
  build
    (compose semigroupoidBuilder
      (insert <trivial evidence> <trivial evidence> (symbol "z") "Proxy" true)
      (insert <trivial evidence> <trivial evidence> (symbol "y") "Proxy" "y"))
    record%1

@export modify = \record%3 ->
  build
    (modify <trivial evidence> <trivial evidence> (symbol "x") "Proxy" (\x%2 -> integer.add x%2 1))
    record%3

@export delete = \record%4 ->
  build (delete (symbol "x") <trivial evidence> <trivial evidence> "Proxy") record%4

@export rename = \record%5 ->
  build
    (rename (symbol "x") (symbol "z") <trivial evidence> <trivial evidence> <trivial evidence>
      <trivial evidence>
      "Proxy"
      "Proxy")
    record%5

@export pipeline = \record%7 ->
  build
    (composeFlipped semigroupoidBuilder
      (insert <trivial evidence> <trivial evidence> (symbol "z") "Proxy" true)
      (composeFlipped semigroupoidBuilder
        (modify <trivial evidence> <trivial evidence> (symbol "x") "Proxy"
          (\x%6 -> integer.multiply x%6 2))
        (composeFlipped semigroupoidBuilder (identity categoryBuilder)
          (composeFlipped semigroupoidBuilder
            (delete (symbol "y") <trivial evidence> <trivial evidence> "Proxy")
            (composeFlipped semigroupoidBuilder
              (rename (symbol "x") (symbol "w") <trivial evidence> <trivial evidence>
                <trivial evidence>
                <trivial evidence>
                "Proxy"
                "Proxy")
              (nub <trivial evidence>))))))
    record%7

@export fromScratch = buildFromScratch
  (composeFlipped semigroupoidBuilder
    (insert <trivial evidence> <trivial evidence> (symbol "x") "Proxy" 1)
    (insert <trivial evidence> <trivial evidence> (symbol "y") "Proxy" "y"))

@export literal = build
  (composeFlipped semigroupoidBuilder
    (insert <trivial evidence> <trivial evidence> (symbol "z") "Proxy" true)
    (composeFlipped semigroupoidBuilder
      (modify <trivial evidence> <trivial evidence> (symbol "x") "Proxy"
        (\x%8 -> integer.multiply x%8 2))
      (composeFlipped semigroupoidBuilder
        (delete (symbol "y") <trivial evidence> <trivial evidence> "Proxy")
        (rename (symbol "x") (symbol "w") <trivial evidence> <trivial evidence> <trivial evidence>
          <trivial evidence>
          "Proxy"
          "Proxy"))))
  { x: 1, y: "y" }

@export unknown = \builder%9 record%10 -> build builder%9 record%10
