@export foreign observe

@export foreign readTrace

@export booleanEqual = \left%0 right%1 -> boolean.equal left%0 right%1

@export integerEqual = \left%2 right%3 -> integer.equal left%2 right%3

@export numberEqual = \left%4 right%5 -> number.equal left%4 right%5

@export charNotEqual = \left%6 right%7 -> char.not_equal left%6 right%7

@export stringNotEqual = \left%8 right%9 -> string.not_equal left%8 right%9

