@export numberLessThanOrEqual = \left%22 right%23 -> number.less_than_or_equal left%22 right%23

@export numberGreaterThan = \left%24 right%25 ->
  boolean.not (number.less_than_or_equal left%24 right%25)

@export numberGreaterThanOrEqual = \left%26 right%27 ->
  boolean.not (number.less_than left%26 right%27)

@export numberNotGreaterThan = \left%28 right%29 -> number.less_than_or_equal left%28 right%29

@export integerBetween = \low%30 high%32 value%31 ->
  boolean.and (integer.less_than_or_equal low%30 value%31) (integer.less_than value%31 high%32)

@export comparisonOrder = \$boolean%33@(_) ->
  integer.less_than (observe "left" 1) (observe "right" 2)

@export comparisonCaseOrder = \left%34 flag%35 ->
  boolean.not (number.less_than_or_equal (observe "left" left%34) (case observe "flag" flag%35 of
    true ->
      observe "right" 1.0
    false ->
      observe "right" 2.0))
