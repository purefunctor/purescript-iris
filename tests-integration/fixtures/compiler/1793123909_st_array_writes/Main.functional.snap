    \array%1 -> effect.bind (effect.pokeArray 1 10 array%1)
      \inside%2 -> effect.bind (effect.pokeArray 3 20 array%1)
        \past%3 -> effect.bind (effect.pokeArray -1 30 array%1)
          \negative%4 -> effect.bind (effect.pokeArray 0 40 array%1)
            \$boolean%5 -> effect.bind (modify 2 (\section114%6 -> integer.multiply section114%6 2)
              array%1)
              \modified%7 -> effect.bind (modify 3
                (\section130%8 -> integer.multiply section130%8 2)
                array%1)
                \unmodified%9 -> effect.bind (effect.copyArray array%1)
                  \final%10 -> effect.pure {
                    inside: inside%2,
