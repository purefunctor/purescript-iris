foreign import constructEffect :: forall a. Prim.String -> a -> Effect.Effect a

timedAdo :: Prim.String -> Effect.Effect { first :: Prim.String, second :: { seed :: Prim.String } }
timedAdo = \seed ->
  apply {applyEffect}
    (map {functorEffect} (\first second -> { first, second }) (constructEffect "ado-first" seed))
    (constructEffect "ado-second" { seed })
