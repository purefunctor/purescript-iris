@export foreign constructEffect

@export timedAdo = \seed%2 ->
  effect.apply
    (effect.map
      (\first%0 second%1 -> { first: first%0, second: second%1 })
      (constructEffect "ado-first" seed%2))
    (constructEffect "ado-second" { seed: seed%2 })
