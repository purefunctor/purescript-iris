  grouped :: forall value.
  Main.Proxy @Prim.Type value -> Main.Proxy @Prim.Type right -> Main.Proxy @Prim.Type value

dictionary grouped1 :: forall t0 function left right. Main.Grouped (function left) (function right)
  where
