    \(_ :: Main.Proxy @Prim.Type (function right)) ->
    let
      local :: forall left2.
  Main.Proxy @Prim.Type left2 ->
  Main.Proxy @Prim.Type (function right) ->
  Main.Proxy @Prim.Type left2
      local = \(localValue :: Main.Proxy @Prim.Type left2) ->
        \(_ :: Main.Proxy @Prim.Type (function right)) -> localValue
    in
      local value Proxy
