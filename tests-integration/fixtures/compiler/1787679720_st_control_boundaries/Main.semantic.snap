---
source: tests-integration/src/fixtures.rs
---
foreign import constructST :: forall region a. Prim.String -> a -> Control.Monad.ST.Internal.ST region a

foreign import mark :: forall a. Prim.String -> a -> a

branched :: forall region. Prim.Boolean -> Prim.String -> Control.Monad.ST.Internal.ST region Prim.String
branched = \choose -> \seed ->
  bind {bindST} (constructST "branch-action" seed) \value ->
    if choose then constructST "branch-then" value else constructST "branch-else" value

patternLet :: forall region. Prim.String -> Control.Monad.ST.Internal.ST region Prim.String
patternLet = \seed ->
  bind {bindST} (constructST "pattern-action" seed) \value ->
    let
      { selected } = { selected: value }
    in
      constructST "pattern-result" selected

genericBind :: forall m a b. Control.Bind.Bind m => m a -> (a -> m b) -> m b
genericBind = \{bindDict} -> bind {bindDict}

aliased :: forall region. Prim.String -> Control.Monad.ST.Internal.ST region Prim.String
aliased = \seed ->
  genericBind {bindST} (constructST "alias-first" seed) \value -> constructST "alias-second" value

deferredST :: forall region. Control.Monad.ST.Internal.ST region Prim.String
deferredST =
  bind {bindST} (constructST "deferred-action" "ignored") \value ->
    constructST "deferred-result" deferredValue

deferredValue :: Prim.String
deferredValue = mark "deferred-value" "deferred"
