source: tests-integration/src/fixtures.rs
---
foreign import equalInt :: Prim.Int -> Prim.Int -> Prim.Boolean

foreign import decrementInt :: Prim.Int -> Prim.Int

localTail :: Prim.Int -> Prim.Int
localTail = \value -> go value
  where
  go :: Prim.Int -> Prim.Int
  go = \current ->
    if equalInt current 0 then current else go (decrementInt current)
