@export predicate = \dictionary%0 -> dictionary%0.predicate

@export defaultValue = \dictionary%1 -> dictionary%1.defaultValue

@export checked = \condition%2 ->
  if condition%2 then 1 else 2

@export inferred = \condition%3 ->
  if condition%3 then "yes" else "no"

@export constrained = \predicateValueDict%4 ->
  \value%5 ->
    if predicate predicateValueDict%4 value%5 then 1 else 2

