data Maybe :: Prim.Type -> Prim.Type
data Maybe @a
  | Nothing :: Main.Maybe a
  | Just :: a -> Main.Maybe a

nested :: forall t0 t1. t0 -> t1 -> t0
nested = \first -> \second -> first

caseBody :: Main.Maybe Prim.Int -> Prim.Int
caseBody = \maybe ->
  case maybe of
    Nothing -> 0
    (Just value) -> value
