less :: Prim.Int -> Prim.Int -> Prim.Boolean
less = \left -> \right -> lessThan {ordInt} left right

keywordLabel :: Prim.Int -> Prim.Boolean
keywordLabel = \right -> lessThan {ordInt} { then: 1 }.then right

operators :: { append :: Prim.String -> Prim.String -> Prim.String
, less :: Prim.Int -> Prim.Int -> Prim.Boolean
, map :: (Prim.Int -> Prim.Int) -> Prim.Array Prim.Int -> Prim.Array Prim.Int
}
