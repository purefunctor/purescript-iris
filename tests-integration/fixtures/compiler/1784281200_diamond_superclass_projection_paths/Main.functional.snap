@export foreign useBottom

@export foreign useLeft

@export foreign useRight

@export foreign useTop

@export testDiamond = \topDict%0 ->
  \value%1 ->
    let
      Left0Dict%2 = topDict%0."Left0"()
    in let
      _ = useTop topDict%0 value%1
    in let
      _ = useLeft Left0Dict%2 value%1
    in let
      _ = useRight (topDict%0."Right1"()) value%1
    in useBottom (Left0Dict%2."Bottom0"()) value%1

@export testShared = \leftDict%3 rightDict%5 ->
  \value%4 ->
    let
      _ = useLeft leftDict%3 value%4
    in let
      _ = useRight rightDict%5 value%4
    in useBottom (leftDict%3."Bottom0"()) value%4
