forwarded :: forall t0 t1. Prim.Partial => Library.Maybe t0 -> Library.Maybe t1 -> { first :: t0, second :: t1 }
forwarded = \{partialDict} -> \first -> \second ->
  let
    extract :: Library.Maybe t0 -> t0
    extract = \wrapped -> unwrap {partialDict} wrapped
  in
    { first: extract first, second: unwrap {partialDict} second }

signed :: Prim.Partial =>
Library.Maybe Prim.Int -> Library.Maybe Prim.Int -> { first :: Prim.Int, second :: Prim.Int }
signed = \{partialDict} -> forwarded {partialDict}

foreign import unsafePartial :: forall a. (Prim.Partial => a) -> a

discharged :: Library.Maybe Prim.Int -> Library.Maybe Prim.Int -> { first :: Prim.Int, second :: Prim.Int }
discharged = unsafePartial \{partialDict} -> forwarded {partialDict}
