@export lookup = \hasServiceServicesDict%0 -> hasServiceServicesDict%0.getService

@export inferred = \services%1 ->
  \environment%2 ->
    case lookup { getService: services%1."Services.Console" } environment%2 of
      value%3 ->
        value%3

@export multiple = \services%4 ->
  \environment%5 ->
    {
      console: lookup { getService: services%4."Services.Console" } environment%5,
      http: lookup { getService: services%4."Services.Http" } environment%5
    }

@export delayed = \services%6 -> lookup { getService: services%6."Services.Console" }

@export inferredValue = inferred { "Services.Console": \environment%7 -> environment%7.logger }
  { logger: 37 }

@export multipleValue = multiple
  {
    "Services.Http": \environment%8 -> environment%8.network,
    "Services.Console": \environment%9 -> environment%9.logger
  }
  { logger: 19, network: 23 }

@export delayedValue = delayed { "Services.Console": \environment%10 -> environment%10.logger }
  { network: 4, logger: 61 }
