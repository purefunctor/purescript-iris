booleanNot :: Prim.Boolean -> Prim.Boolean
booleanNot = \value -> not {heytingAlgebraBoolean} value

booleanConj :: Prim.Boolean -> Prim.Boolean -> Prim.Boolean
booleanConj = \left -> \right -> conj {heytingAlgebraBoolean} left right

booleanDisj :: Prim.Boolean -> Prim.Boolean -> Prim.Boolean
booleanDisj = \left -> \right -> disj {heytingAlgebraBoolean} left right

