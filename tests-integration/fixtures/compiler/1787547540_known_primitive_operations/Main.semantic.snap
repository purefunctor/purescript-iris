conjOrder :: Prim.Boolean -> Prim.Boolean -> Prim.Boolean
conjOrder = \left -> \right ->
  conj {heytingAlgebraBoolean} (observe "left" left) (observe "right" right)

disjOrder :: Prim.Boolean -> Prim.Boolean -> Prim.Boolean
disjOrder = \left -> \right ->
  disj {heytingAlgebraBoolean} (observe "left" left) (observe "right" right)

conjCase :: Prim.Boolean -> Prim.Boolean -> Prim.Boolean
conjCase = \left -> \right ->
  conj {heytingAlgebraBoolean} (observe "left" left) case observe "right" right of
    true -> true
    false -> false

disjCase :: Prim.Boolean -> Prim.Boolean -> Prim.Boolean
disjCase = \left -> \right ->
  disj {heytingAlgebraBoolean} (observe "left" left) case observe "right" right of
    true -> true
    false -> false

conjFunctionOrder :: Prim.Boolean -> Prim.Boolean -> Prim.Boolean
conjFunctionOrder = \left -> \right ->
  observe "function" (\value -> value)
    (conj {heytingAlgebraBoolean} (observe "left" left) case observe "right" right of
      true -> true
      false -> false)

conjPatternFunctionOrder :: Prim.Boolean -> Prim.Boolean -> Prim.Boolean
conjPatternFunctionOrder = \left -> \right ->
  observe "function" (\value -> value)
    (conj {heytingAlgebraBoolean} (observe "left" left)
      ((\{ value } -> value) { value: observe "right" right }))

