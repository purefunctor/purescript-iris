data Either :: Prim.Type -> Prim.Type -> Prim.Type
data Either @a @b
  | Left :: a -> Main.Either a b
  | Right :: b -> Main.Either a b

data Pair :: Prim.Type -> Prim.Type -> Prim.Type
data Pair @a @b
  | Pair :: a -> b -> Main.Pair a b

data Const2 :: forall k0 k1. Prim.Type -> k0 -> k1 -> Prim.Type
data Const2 @value @a @b
  | Const2 :: value -> Main.Const2 value a b

data WrapBoth :: forall k0 k1. (k0 -> Prim.Type) -> (k1 -> Prim.Type) -> k0 -> k1 -> Prim.Type
data WrapBoth @f @g @a @b
  | WrapBoth :: f a -> g b -> Main.WrapBoth f g a b

data Tuple :: Prim.Type -> Prim.Type -> Prim.Type
data Tuple @a @b
  | Tuple :: a -> b -> Main.Tuple a b

data Both :: Prim.Type -> Prim.Type -> Prim.Type
data Both @a @b
  | Both :: Main.Tuple a b -> Main.Both a b

data OneSided :: Prim.Type -> Prim.Type -> Prim.Type
data OneSided @a @b
  | OneSidedFirst :: Main.Tuple a Prim.Int -> Main.OneSided a b
  | OneSidedSecond :: Main.Tuple Prim.Int b -> Main.OneSided a b

data Box :: Prim.Type -> Prim.Type
data Box @a
  | Box :: a -> Main.Box a

data Nested :: Prim.Type -> Prim.Type -> Prim.Type
data Nested @a @b
  | Nested :: Main.Box (Main.Tuple a b) -> Main.Nested a b

data Triple :: Prim.Type -> Prim.Type -> Prim.Type -> Prim.Type
data Triple @fixed @a @b
  | Triple :: fixed -> a -> b -> Main.Triple fixed a b

data NestedTriple :: Prim.Type -> Prim.Type -> Prim.Type
data NestedTriple @a @b
  | NestedTriple :: Main.Triple Prim.Int a b -> Main.NestedTriple a b

data NestedTripleLast :: forall k0. k0 -> Prim.Type -> Prim.Type
data NestedTripleLast @a @b
  | NestedTripleLast :: Main.Triple Prim.Int Prim.String b -> Main.NestedTripleLast a b

data ReaderPair :: Prim.Type -> Prim.Type -> Prim.Type
data ReaderPair @a @b
  | ReaderPair :: (Prim.Int -> Main.Tuple a b) -> Main.ReaderPair a b

data RecordPair :: Prim.Type -> Prim.Type -> Prim.Type
data RecordPair @a @b
  | RecordPair :: { first :: a, fixed :: Prim.Int, second :: b } -> Main.RecordPair a b

dictionary bifunctorEither :: Data.Bifunctor.Bifunctor Main.Either where
  bimap :: forall a b c d. (a -> b) -> (c -> d) -> Main.Either a c -> Main.Either b d
  bimap = \firstFunction secondFunction value ->
    case value of
      (Left field0) -> Left (firstFunction field0)
      (Right field0) -> Right (secondFunction field0)

dictionary bifunctorPair :: Data.Bifunctor.Bifunctor Main.Pair where
  bimap :: forall a b c d. (a -> b) -> (c -> d) -> Main.Pair a c -> Main.Pair b d
  bimap = \firstFunction secondFunction value ->
    case value of
      (Pair field0 field1) -> Pair (firstFunction field0) (secondFunction field1)

