@export foreign observe

@export foreign readTrace

@export delete = \record%0 ->
  delete (symbol "x") <trivial evidence> <trivial evidence> "Proxy" record%0

@export deleteQuoted = \record%1 ->
  delete (symbol "first name") <trivial evidence> <trivial evidence> "Proxy" record%1

@export deleteOrder = \record%2 ->
  {
    first: observe "first" 1,
    rest:
      delete (symbol "x") <trivial evidence> <trivial evidence> "Proxy" (observe "record" record%2)
  }
