---
source: tests-integration/src/fixtures.rs
---
@export isLess = \left%0 right%1 ->
  if integer.less_than left%0 right%1 then "less" else "not less"

@export describeOrdering = \left%3 right%4 ->
  case compare ordInt left%3 right%4 of
    LT ->
      "less"
    other%5 ->
      show showOrdering other%5
