data Maybe :: Prim.Type -> Prim.Type
data Maybe @a
  | Just :: a -> Main.Maybe a
  | Nothing :: Main.Maybe a

fromMaybe :: forall t0. t0 -> Main.Maybe t0 -> t0
fromMaybe = \default -> \(Just value) -> value
fromMaybe = \default -> \Nothing -> default
