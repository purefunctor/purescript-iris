data Tuple :: Prim.Type -> Prim.Type -> Prim.Type
data Tuple @a @b
  | Tuple :: a -> b -> Main.Tuple a b

foreign import bind :: forall m a b. m a -> (a -> m b) -> m b

foreign import discard :: forall m a b. m a -> (a -> m b) -> m b

foreign import pure :: forall m a. a -> m a

test :: forall m. m (Main.Tuple Prim.Int Prim.String)
test = bind (pure 1) \x -> bind (pure "hello") \y -> pure (Tuple x y)

test' :: forall t0. t0 (Main.Tuple Prim.Int Prim.String)
test' = bind (pure 1) \x -> bind (pure "hello") \y -> pure (Tuple x y)
