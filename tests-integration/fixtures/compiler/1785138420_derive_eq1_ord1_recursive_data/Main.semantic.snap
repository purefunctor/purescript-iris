data List :: Prim.Type -> Prim.Type
data List @a
  | Nil :: Main.List a
  | Cons :: a -> Main.List a -> Main.List a

data Tree :: Prim.Type -> Prim.Type
data Tree @a
  | Leaf :: a -> Main.Tree a
  | Branch :: Main.Tree a -> Main.Tree a -> Main.Tree a

dictionary eqList :: forall a. { eqDict :: Data.Eq.Eq a } => Data.Eq.Eq (Main.List a) where
  eq :: Main.List a -> Main.List a -> Prim.Boolean
  eq = \left right ->
    case left, right of
      Nil, Nil -> true
      (Cons left0 left1), (Cons right0 right1) ->
        if eq {eqDict} left0 right0 then
          if eq {eqList {eqDict}} left1 right1 then true else false
        else
          false
      _, _ -> false

dictionary eq1List :: Data.Eq.Eq1 Main.List where
  eq1 :: forall a. Data.Eq.Eq a => Main.List a -> Main.List a -> Prim.Boolean
  eq1 = \{eqDict} -> eq {eqList {eqDict}}

dictionary ordList :: forall a. { ordDict :: Data.Ord.Ord a } => Data.Ord.Ord (Main.List a) where
  superclass eqDict = eqList {ordDict.eqDict}
  compare :: Main.List a -> Main.List a -> Data.Ordering.Ordering
  compare = \left right ->
    case left, right of
      Nil, Nil -> EQ
      Nil, _ -> LT
      _, Nil -> GT
      (Cons left0 left1), (Cons right0 right1) ->
        case compare {ordDict} left0 right0 of
          EQ ->
            case compare {ordList {ordDict}} left1 right1 of
              EQ -> EQ
              ordering -> ordering
          ordering -> ordering

dictionary ord1List :: Data.Ord.Ord1 Main.List where
  superclass eq1Dict = eq1List
  compare1 :: forall a. Data.Ord.Ord a => Main.List a -> Main.List a -> Data.Ordering.Ordering
  compare1 = \{ordDict} -> compare {ordList {ordDict}}

dictionary eqTree :: forall a. { eqDict :: Data.Eq.Eq a } => Data.Eq.Eq (Main.Tree a) where
  eq :: Main.Tree a -> Main.Tree a -> Prim.Boolean
  eq = \left right ->
    case left, right of
      (Leaf left0), (Leaf right0) ->
        if eq {eqDict} left0 right0 then true else false
      (Branch left0 left1), (Branch right0 right1) ->
        if eq {eqTree {eqDict}} left0 right0 then
          if eq {eqTree {eqDict}} left1 right1 then true else false
        else
          false
      _, _ -> false

dictionary eq1Tree :: Data.Eq.Eq1 Main.Tree where
  eq1 :: forall a. Data.Eq.Eq a => Main.Tree a -> Main.Tree a -> Prim.Boolean
  eq1 = \{eqDict} -> eq {eqTree {eqDict}}

dictionary ordTree :: forall a. { ordDict :: Data.Ord.Ord a } => Data.Ord.Ord (Main.Tree a) where
  superclass eqDict = eqTree {ordDict.eqDict}
  compare :: Main.Tree a -> Main.Tree a -> Data.Ordering.Ordering
  compare = \left right ->
    case left, right of
      (Leaf left0), (Leaf right0) ->
        case compare {ordDict} left0 right0 of
          EQ -> EQ
          ordering -> ordering
      (Leaf _), _ -> LT
      _, (Leaf _) -> GT
      (Branch left0 left1), (Branch right0 right1) ->
        case compare {ordTree {ordDict}} left0 right0 of
          EQ ->
            case compare {ordTree {ordDict}} left1 right1 of
              EQ -> EQ
              ordering -> ordering
          ordering -> ordering

dictionary ord1Tree :: Data.Ord.Ord1 Main.Tree where
  superclass eq1Dict = eq1Tree
  compare1 :: forall a. Data.Ord.Ord a => Main.Tree a -> Main.Tree a -> Data.Ordering.Ordering
  compare1 = \{ordDict} -> compare {ordTree {ordDict}}
