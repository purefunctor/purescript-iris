---
source: tests-integration/src/fixtures.rs
---
data Choice :: Prim.Type -> Prim.Type
data Choice @a
  | Empty :: Main.Choice a
  | One :: a -> Main.Choice a
  | Pair :: a -> a -> Main.Choice a

guarded :: Prim.Boolean -> Main.Choice (Main.Choice Prim.Int) -> Prim.Int
guarded = \condition -> \choice ->
  case choice of
    (One nested)
      | condition, (One value) <- nested -> value
    (Pair left right)
      | (One value) <- left -> value
      | (One value) <- right -> value
    _ -> 0

withWhere :: Main.Choice Prim.Int -> Prim.Int
withWhere = \choice ->
  case choice of
    (One value) -> local
      where
      local :: Prim.Int
      local = value
    _ -> 0
