@export foreign push

@export foreign poke

@export visit = \values%1 ->
  effect.bind (effect.newReference [])
    \seen%0 -> effect.bind (effect.forEach
      values%1
      (\value%2 ->
        effect.bind (when applicativeEffect (integer.equal value%2 1) (poke values%1 2 99))
