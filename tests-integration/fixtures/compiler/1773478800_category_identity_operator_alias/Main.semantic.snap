interface Semigroupoid :: forall k. (k -> k -> Prim.Type) -> Prim.Constraint
interface Semigroupoid a where
  compose :: forall (b :: k) (c :: k) (d :: k). a c d -> a b c -> a b d

interface Category :: forall k. (k -> k -> Prim.Type) -> Prim.Constraint
interface Category a where
  superclass semigroupoidDict :: Main.Semigroupoid @k a
  identity :: forall (t :: k). a t t

dictionary semigroupoidFn :: Main.Semigroupoid @Prim.Type Prim.Function where
  compose :: forall b c d. Prim.Function c d -> Prim.Function b c -> Prim.Function b d
  compose = \f -> \g -> \x -> f (g x)

dictionary categoryFn :: Main.Category @Prim.Type Prim.Function where
  superclass semigroupoidDict = semigroupoidFn
  identity :: forall t. Prim.Function t t
  identity = \x -> x

test :: forall a. a -> a
test = \x -> identity {categoryFn} (identity {categoryFn}) x
