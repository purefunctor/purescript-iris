---
source: tests-integration/src/fixtures.rs
---
data Either :: Prim.Type -> Prim.Type -> Prim.Type
data Either @a @b
  | Left :: a -> Main.Either a b
  | Right :: b -> Main.Either a b

data Pair :: Prim.Type -> Prim.Type -> Prim.Type
data Pair @a @b
  | Pair :: a -> b -> Main.Pair a b

dictionary bifunctorEither :: Data.Bifunctor.Bifunctor Main.Either where
  bimap :: forall a b c d. (a -> b) -> (c -> d) -> Main.Either a c -> Main.Either b d
  bimap = \firstFunction secondFunction value ->
    case value of
      (Left field0) -> Left (firstFunction field0)
      (Right field0) -> Right (secondFunction field0)

dictionary bifoldableEither :: Data.Bifoldable.Bifoldable Main.Either where
  bifoldr :: forall a b c. (a -> c -> c) -> (b -> c -> c) -> c -> Main.Either a b -> c
  bifoldr = \firstFunction secondFunction accumulator value ->
    case value of
      (Left field0) -> firstFunction field0 accumulator
      (Right field0) -> secondFunction field0 accumulator
  bifoldl :: forall a b c. (c -> a -> c) -> (c -> b -> c) -> c -> Main.Either a b -> c
  bifoldl = \firstFunction secondFunction accumulator value ->
    case value of
      (Left field0) -> firstFunction accumulator field0
      (Right field0) -> secondFunction accumulator field0
  bifoldMap :: forall m a b. Data.Monoid.Monoid m => (a -> m) -> (b -> m) -> Main.Either a b -> m
  bifoldMap = \{monoidDict} ->
    \firstFunction secondFunction value ->
      case value of
        (Left field0) -> firstFunction field0
        (Right field0) -> secondFunction field0

dictionary bitraversableEither :: Data.Bitraversable.Bitraversable Main.Either where
  superclass bifunctorDict = bifunctorEither
  superclass bifoldableDict = bifoldableEither
  bitraverse :: forall (f :: Prim.Type -> Prim.Type) a b c d.
  Control.Applicative.Applicative f =>
  (a -> f c) -> (b -> f d) -> Main.Either a b -> f (Main.Either c d)
  bitraverse = \{applicativeDict} ->
    \firstFunction secondFunction value ->
      case value of
        (Left field0) -> map {applicativeDict.applyDict.functorDict}
          (\field0Result -> Left field0Result)
          (firstFunction field0)
        (Right field0) -> map {applicativeDict.applyDict.functorDict}
          (\field0Result -> Right field0Result)
          (secondFunction field0)
  bisequence :: forall (f :: Prim.Type -> Prim.Type) a b.
  Control.Applicative.Applicative f => Main.Either (f a) (f b) -> f (Main.Either a b)
  bisequence = \{applicativeDict} ->
    \value ->
      bitraverse {bitraversableEither} {applicativeDict} (\effect0 -> effect0) (\effect1 -> effect1)
        value

dictionary bifunctorPair :: Data.Bifunctor.Bifunctor Main.Pair where
  bimap :: forall a b c d. (a -> b) -> (c -> d) -> Main.Pair a c -> Main.Pair b d
  bimap = \firstFunction secondFunction value ->
    case value of
      (Pair field0 field1) -> Pair (firstFunction field0) (secondFunction field1)

dictionary bifoldablePair :: Data.Bifoldable.Bifoldable Main.Pair where
  bifoldr :: forall a b c. (a -> c -> c) -> (b -> c -> c) -> c -> Main.Pair a b -> c
  bifoldr = \firstFunction secondFunction accumulator value ->
    case value of
      (Pair field0 field1) -> firstFunction field0 (secondFunction field1 accumulator)
  bifoldl :: forall a b c. (c -> a -> c) -> (c -> b -> c) -> c -> Main.Pair a b -> c
  bifoldl = \firstFunction secondFunction accumulator value ->
    case value of
      (Pair field0 field1) -> secondFunction (firstFunction accumulator field0) field1
  bifoldMap :: forall m a b. Data.Monoid.Monoid m => (a -> m) -> (b -> m) -> Main.Pair a b -> m
  bifoldMap = \{monoidDict} ->
    \firstFunction secondFunction value ->
      case value of
        (Pair field0 field1) -> append {monoidDict.semigroupDict} (firstFunction field0)
          (secondFunction field1)

dictionary bitraversablePair :: Data.Bitraversable.Bitraversable Main.Pair where
  superclass bifunctorDict = bifunctorPair
  superclass bifoldableDict = bifoldablePair
  bitraverse :: forall (f :: Prim.Type -> Prim.Type) a b c d.
  Control.Applicative.Applicative f =>
  (a -> f c) -> (b -> f d) -> Main.Pair a b -> f (Main.Pair c d)
  bitraverse = \{applicativeDict} ->
    \firstFunction secondFunction value ->
      case value of
        (Pair field0 field1) -> apply {applicativeDict.applyDict}
          (map {applicativeDict.applyDict.functorDict}
            (\field0Result field1Result -> Pair field0Result field1Result)
            (firstFunction field0))
          (secondFunction field1)
  bisequence :: forall (f :: Prim.Type -> Prim.Type) a b.
  Control.Applicative.Applicative f => Main.Pair (f a) (f b) -> f (Main.Pair a b)
  bisequence = \{applicativeDict} ->
    \value ->
      bitraverse {bitraversablePair} {applicativeDict} (\effect0 -> effect0) (\effect1 -> effect1)
        value
