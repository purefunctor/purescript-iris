data Duplicate :: forall k0. (k0 -> k0 -> Prim.Type) -> k0 -> Prim.Type
data Duplicate @p @a
  | Duplicate :: p a a -> Main.Duplicate p a

dictionary foldableDuplicateType ::
  forall p.
  { bifoldableDict :: Data.Bifoldable.Bifoldable p } =>
  Data.Foldable.Foldable (Main.Duplicate @Prim.Type p)
  where
  foldr :: forall a b. (a -> b -> b) -> b -> Main.Duplicate @Prim.Type p a -> b
  foldr = \function accumulator value ->
    case value of
      (Duplicate field0) -> bifoldr {bifoldableDict}
        (\element accumulator -> function element accumulator)
        (\element accumulator -> function element accumulator)
        accumulator
        field0
  foldl :: forall a b. (b -> a -> b) -> b -> Main.Duplicate @Prim.Type p a -> b
  foldl = \function accumulator value ->
    case value of
      (Duplicate field0) -> bifoldl {bifoldableDict}
        (\accumulator element -> function accumulator element)
        (\accumulator element -> function accumulator element)
        accumulator
        field0
  foldMap :: forall a m. Data.Monoid.Monoid m => (a -> m) -> Main.Duplicate @Prim.Type p a -> m
  foldMap = \{monoidDict} ->
    \function value ->
      case value of
        (Duplicate field0) -> bifoldMap {bifoldableDict} {monoidDict} (\element -> function element)
          (\element -> function element)
          field0
