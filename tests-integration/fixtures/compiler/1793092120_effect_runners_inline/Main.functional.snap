@export performed = unsafePerformEffect
  (effect.bind (effect.newReference 20)
    \ref%0 -> effect.modifyReferenceState (\section61%1 -> integer.add section61%1 1) ref%0)

@export doubled = \value%2 ->
  run
    (effect.bind (effect.newReference value%2)
      \ref%3 -> effect.modifyReferenceState (\section96%4 -> integer.multiply section96%4 2) ref%3)

@export offset = \value%5 -> integer.add 1 (run (effect.pure value%5))

@export performedAction = \action%6 -> unsafePerformEffect action%6

@export runAction = \action%7 -> run action%7
