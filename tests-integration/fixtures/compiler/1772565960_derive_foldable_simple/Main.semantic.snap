data Identity :: Prim.Type -> Prim.Type
data Identity @a
  | Identity :: a -> Main.Identity a

data Maybe :: Prim.Type -> Prim.Type
data Maybe @a
  | Nothing :: Main.Maybe a
  | Just :: a -> Main.Maybe a

data Const :: forall k0. Prim.Type -> k0 -> Prim.Type
data Const @e @a
  | Const :: e -> Main.Const e a

dictionary foldableIdentity :: Data.Foldable.Foldable Main.Identity where
  foldr :: forall a b. (a -> b -> b) -> b -> Main.Identity a -> b
  foldr = \function accumulator value ->
    case value of
      (Identity field0) -> function field0 accumulator
  foldl :: forall a b. (b -> a -> b) -> b -> Main.Identity a -> b
  foldl = \function accumulator value ->
    case value of
      (Identity field0) -> function accumulator field0
  foldMap :: forall a m. Data.Monoid.Monoid m => (a -> m) -> Main.Identity a -> m
  foldMap = \{monoidDict} ->
    \function value ->
      case value of
        (Identity field0) -> function field0

dictionary foldableMaybe :: Data.Foldable.Foldable Main.Maybe where
  foldr :: forall a b. (a -> b -> b) -> b -> Main.Maybe a -> b
  foldr = \function accumulator value ->
    case value of
      Nothing -> accumulator
      (Just field0) -> function field0 accumulator
  foldl :: forall a b. (b -> a -> b) -> b -> Main.Maybe a -> b
  foldl = \function accumulator value ->
    case value of
      Nothing -> accumulator
      (Just field0) -> function accumulator field0
  foldMap :: forall a m. Data.Monoid.Monoid m => (a -> m) -> Main.Maybe a -> m
  foldMap = \{monoidDict} ->
    \function value ->
      case value of
        Nothing -> mempty {monoidDict}
        (Just field0) -> function field0

dictionary foldableConstType :: forall e. Data.Foldable.Foldable (Main.Const @Prim.Type e) where
  foldr :: forall a b. (a -> b -> b) -> b -> Main.Const @Prim.Type e a -> b
  foldr = \function accumulator value ->
    case value of
      (Const field0) -> accumulator
  foldl :: forall a b. (b -> a -> b) -> b -> Main.Const @Prim.Type e a -> b
  foldl = \function accumulator value ->
    case value of
      (Const field0) -> accumulator
  foldMap :: forall a m. Data.Monoid.Monoid m => (a -> m) -> Main.Const @Prim.Type e a -> m
  foldMap = \{monoidDict} ->
    \function value ->
      case value of
        (Const field0) -> mempty {monoidDict}
