foreign import lessThan :: Prim.Int -> Prim.Int -> Prim.Boolean

test :: Prim.Int -> Prim.Int
test = \x ->
  case x of
    n
      | lessThan n 0 -> 0
      | otherwise -> n

test' :: Prim.Int -> Prim.Int
test' = \x ->
  case x of
    n
      | lessThan n 0 -> 0
      | otherwise -> n

test2 :: Prim.Int -> Prim.Int
test2 = \x ->
  case x of
    n
      | lessThan n 0 -> 0
      | true -> n

test2' :: Prim.Int -> Prim.Int
test2' = \x ->
  case x of
