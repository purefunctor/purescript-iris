data Reader :: Prim.Type -> Prim.Type
data Reader @a
  | Reader :: (Prim.Int -> a) -> Main.Reader a

dictionary functorReader :: Data.Functor.Functor Main.Reader where
  map :: forall a b. (a -> b) -> Main.Reader a -> Main.Reader b
  map = \function value ->
    case value of
      (Reader field0) -> Reader \argument -> function (field0 argument)

dictionary foldableReader :: Data.Foldable.Foldable Main.Reader where
  foldr :: forall a b. (a -> b -> b) -> b -> Main.Reader a -> b
  foldr = \_ -> \initial -> \_ -> initial
  foldl :: forall a b. (b -> a -> b) -> b -> Main.Reader a -> b
  foldl = \_ -> \initial -> \_ -> initial
  foldMap :: forall a m. Data.Monoid.Monoid m => (a -> m) -> Main.Reader a -> m
  foldMap = \{monoidDict} -> \_ -> \_ -> mempty {monoidDict}
