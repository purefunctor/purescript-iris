interface Convert :: Prim.Type -> Prim.Type -> Prim.Constraint
interface Convert a b where
  convert :: a -> b

interface TypeEq :: forall k. k -> k -> Prim.Constraint
interface TypeEq a b where

dictionary convertIntString :: Main.Convert Prim.Int Prim.String where
  convert :: Prim.Int -> Prim.String
  convert = \_ -> "int"

test :: Prim.String
test = convert {convertIntString} 42

dictionary typeEq :: forall k a. Main.TypeEq @k a a
