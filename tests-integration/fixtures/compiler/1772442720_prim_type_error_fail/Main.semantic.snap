---
source: tests-integration/src/fixtures.rs
---
data Proxy :: forall k. k -> Prim.Type
data Proxy @a
  | Proxy :: Main.Proxy a

failBasic :: forall a. Prim.TypeError.Fail (Prim.TypeError.Text "This operation is not allowed") => a -> a
failBasic = \{failDict} -> \x -> x

useFailBasic :: Prim.Int
useFailBasic = failBasic {error} 42

failComplex :: forall t0 a.
  Prim.TypeError.Fail
    (Prim.TypeError.Above
      (Prim.TypeError.Text "Error:")
      (Prim.TypeError.Beside (Prim.TypeError.Text "Type ") (Prim.TypeError.Quote @t0 a))) =>
  Main.Proxy @t0 a -> Main.Proxy @t0 a
failComplex = \{failDict} -> \p -> p

useFailComplex :: Main.Proxy @Prim.Type Prim.String
useFailComplex = failComplex {error} Proxy
