mutual :: Prim.Boolean -> Prim.Int
mutual = \condition -> first condition
  where
  first :: Prim.Boolean -> Prim.Int
  first = \true -> 1
  first = \false -> second true
  second :: Prim.Boolean -> Prim.Int
  second = \true -> 2
  second = \false -> first true

capturedMutual :: Prim.Int -> Prim.Boolean -> Prim.Int
capturedMutual = \captured -> \condition -> first condition
  where
  first :: Prim.Boolean -> Prim.Int
  first = \true -> captured
  first = \false -> second true
  second :: Prim.Boolean -> Prim.Int
  second = \true -> captured
  second = \false -> first true

nestedRecursive :: Prim.Boolean -> Prim.Int
nestedRecursive = \condition -> go condition
  where
  go :: Prim.Boolean -> Prim.Int
  go = \true ->
    let
      nested :: Prim.Int
      nested = go false
    in
      nested
  go = \false -> 0
