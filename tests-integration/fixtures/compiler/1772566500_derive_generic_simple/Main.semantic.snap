data Void :: Prim.Type
data Void

data MyUnit :: Prim.Type
data MyUnit
  | MyUnit :: Main.MyUnit

data Identity :: Prim.Type -> Prim.Type
data Identity @a
  | Identity :: a -> Main.Identity a

data Either :: Prim.Type -> Prim.Type -> Prim.Type
data Either @a @b
  | Left :: a -> Main.Either a b
  | Right :: b -> Main.Either a b

data Tuple :: Prim.Type -> Prim.Type -> Prim.Type
data Tuple @a @b
  | Tuple :: a -> b -> Main.Tuple a b

newtype Wrapper :: Prim.Type -> Prim.Type
newtype Wrapper @a
  | Wrapper :: a -> Main.Wrapper a

data Proxy :: forall k0. k0 -> Prim.Type
data Proxy @a
  | Proxy :: Main.Proxy a

dictionary genericVoidNoConstructors ::
  Data.Generic.Rep.Generic Main.Void Data.Generic.Rep.NoConstructors
  where
  to :: Data.Generic.Rep.NoConstructors -> Main.Void
  to = \value ->
    case value of
      _ -> to {genericVoidNoConstructors} value
  from :: Main.Void -> Data.Generic.Rep.NoConstructors
  from = \value ->
    case value of
      _ -> from {genericVoidNoConstructors} value

dictionary genericMyUnitConstructorNoArguments ::
  Data.Generic.Rep.Generic
  Main.MyUnit
  (Data.Generic.Rep.Constructor "MyUnit" Data.Generic.Rep.NoArguments)
  where
  to :: Data.Generic.Rep.Constructor "MyUnit" Data.Generic.Rep.NoArguments -> Main.MyUnit
  to = \representation ->
    case representation of
      (Constructor NoArguments) -> MyUnit
  from :: Main.MyUnit -> Data.Generic.Rep.Constructor "MyUnit" Data.Generic.Rep.NoArguments
  from = \value ->
    case value of
      MyUnit -> Constructor NoArguments

dictionary genericIdentityConstructorArgument ::
