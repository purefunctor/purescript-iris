getVoid :: forall rep. Data.Generic.Rep.Generic Main.Void rep => Main.Proxy @Prim.Type rep
getVoid = \{genericDict} -> Proxy

getMyUnit :: forall rep. Data.Generic.Rep.Generic Main.MyUnit rep => Main.Proxy @Prim.Type rep
getMyUnit = \{genericDict} -> Proxy

getIdentity :: forall a rep. Data.Generic.Rep.Generic (Main.Identity a) rep => Main.Proxy @Prim.Type rep
getIdentity = \{genericDict} -> Proxy

getEither :: forall a b rep. Data.Generic.Rep.Generic (Main.Either a b) rep => Main.Proxy @Prim.Type rep
getEither = \{genericDict} -> Proxy

getTuple :: forall a b rep. Data.Generic.Rep.Generic (Main.Tuple a b) rep => Main.Proxy @Prim.Type rep
getTuple = \{genericDict} -> Proxy

getWrapper :: forall a rep. Data.Generic.Rep.Generic (Main.Wrapper a) rep => Main.Proxy @Prim.Type rep
getWrapper = \{genericDict} -> Proxy

forceSolve :: forall t0 t1 t2 t3 t4 t5.
  { getEither ::
      Main.Proxy @Prim.Type
        (Data.Generic.Rep.Sum
          (Data.Generic.Rep.Constructor "Left" (Data.Generic.Rep.Argument t0))
          (Data.Generic.Rep.Constructor "Right" (Data.Generic.Rep.Argument t1)))
  , getIdentity ::
      Main.Proxy @Prim.Type (Data.Generic.Rep.Constructor "Identity" (Data.Generic.Rep.Argument t2))
  , getMyUnit ::
      Main.Proxy @Prim.Type (Data.Generic.Rep.Constructor "MyUnit" Data.Generic.Rep.NoArguments)
  , getTuple ::
      Main.Proxy @Prim.Type
        (Data.Generic.Rep.Constructor
          "Tuple"
          (Data.Generic.Rep.Product (Data.Generic.Rep.Argument t3) (Data.Generic.Rep.Argument t4)))
  , getVoid :: Main.Proxy @Prim.Type Data.Generic.Rep.NoConstructors
  , getWrapper ::
      Main.Proxy @Prim.Type (Data.Generic.Rep.Constructor "Wrapper" (Data.Generic.Rep.Argument t5))
  }
forceSolve =
  { getVoid: getVoid {genericVoidNoConstructors}, getMyUnit: getMyUnit {genericMyUnitConstructorNoArguments}, getIdentity: getIdentity {genericIdentityConstructorArgument}, getEither: getEither {genericEitherSumConstructorArgumentConstructorArgument}, getTuple: getTuple {genericTupleConstructorProductArgumentArgument}, getWrapper: getWrapper {genericWrapperConstructorArgument} }
