apply :: forall a b. (a -> b) -> a -> b
apply = \function -> \value -> function value

argument :: forall t0. t0 -> t0
argument = apply \value -> value

functionPosition :: forall t0 t1. (t0 -> t1) -> t0 -> t1
functionPosition = (\function -> function) apply
