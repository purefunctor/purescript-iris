variables :: { accent :: Iris.StyleX.Variable (Iris.StyleX.TypedValue Iris.StyleX.Types.Color Prim.String)
, spacing :: Iris.StyleX.Variable (Iris.StyleX.TypedValue Iris.StyleX.Types.Length Prim.String)
}
variables =
  defineVars {compileVars {trivial} {compileVarListConsType {compileVarListConsType {compileVarListNilTypeRow} {trivial}} {trivial}}}
    { accent: color {stringValueString} "blue", spacing: length {stringOrNumberValueString} "8px" }

valid :: Iris.StyleX.Style
valid =
  createTheme {themeOverrides {trivial} {themeOverrideListConsType {trivial} {themeOverrideListNilType}}}
    variables
    { accent: color {stringValueString} "white" }

wrongType :: Iris.StyleX.Style
wrongType =
  createTheme {themeOverrides {trivial} {themeOverrideListConsType {trivial} {themeOverrideListNilType}}}
    variables
    { accent: length {stringOrNumberValueString} "12px" }

unknown :: Iris.StyleX.Style
unknown =
  createTheme {themeOverrides {trivial} {themeOverrideListConsType {trivial} {themeOverrideListNilType}}}
    variables
    { missing: color {stringValueString} "red" }

invalidInteger :: { value :: Iris.StyleX.Variable (Iris.StyleX.TypedValue Iris.StyleX.Types.Integer Prim.Boolean) }
invalidInteger =
  defineVars {compileVars {trivial} {compileVarListConsType {compileVarListNilTypeRow} {trivial}}}
    { value: integer {error} true }

invalidNumber :: { value :: Iris.StyleX.Variable (Iris.StyleX.TypedValue Iris.StyleX.Types.Number Prim.String) }
invalidNumber =
  defineVars {compileVars {trivial} {compileVarListConsType {compileVarListNilTypeRow} {trivial}}}
    { value: number {error} "1" }

invalidColor :: { value :: Iris.StyleX.Variable (Iris.StyleX.TypedValue Iris.StyleX.Types.Color Prim.Int) }
invalidColor =
  defineVars {compileVars {trivial} {compileVarListConsType {compileVarListNilTypeRow} {trivial}}}
    { value: color {error} 42 }
