test :: forall m a. Control.Monad.Rec.Class.MonadRec m => a -> m a
test = \{monadRecDict} -> \a -> go a
  where
  go :: a -> m a
  go = \x -> pure {monadRecDict.monadDict.applicativeDict} x

test2 :: forall m a. Control.Monad.Rec.Class.MonadRec m => m a -> m a
test2 = \{monadRecDict} -> \ma -> go ma
  where
  go :: m a -> m a
  go = \x ->
    bind {monadRecDict.monadDict.bindDict} x (pure {monadRecDict.monadDict.applicativeDict})

test3 :: forall m. Control.Monad.Rec.Class.MonadRec m => m Prim.Int -> m Prim.Int
test3 = \{monadRecDict} -> \mi -> go mi
  where
  go :: m Prim.Int -> m Prim.Int
  go = \x -> map {monadRecDict.monadDict.applicativeDict.applyDict.functorDict} (\y -> y) x
