Terms

Types
Add :: forall t0 t1. t0 -> t1 -> t0
+ :: forall t0 t1. t0 -> t1 -> t0
Chain :: forall t0 t1 t2. t0 -> t1 -> t2 -> t0
ChainParen :: forall t0 t1 t2. t0 -> t1 -> t2 -> t0

Synonyms
type Add a b = (a :: t0)
type Chain a b c = Main.Add @t0 @t1 (Main.Add @t0 @t2 (a :: t0) (b :: t2)) (c :: t1)
type ChainParen a b c = Main.Add @t0 @t1 (Main.Add @t0 @t2 (a :: t0) (b :: t2)) (c :: t1)
