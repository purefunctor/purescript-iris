data Unit :: Prim.Type
data Unit
  | Unit :: Main.Unit

data Proxy :: Prim.Type -> Prim.Type
data Proxy @value
  | Proxy :: Main.Proxy value

foreign import consume :: (Main.Unit -> (forall value. Main.Proxy value)) -> Main.Unit

test :: Main.Unit
test = consume \_ -> \extra -> Proxy
