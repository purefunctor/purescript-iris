data Maybe :: Prim.Type -> Prim.Type
data Maybe @a
  | Just :: a -> Main.Maybe a
  | Nothing :: Main.Maybe a

newtype Box :: Prim.Type -> Prim.Type
newtype Box @a
  | Box :: a -> Main.Box a

data Pair :: Prim.Type -> Prim.Type -> Prim.Type
data Pair @a @b
  | Pair :: a -> b -> Main.Pair a b

operatorGuard :: Main.Maybe Prim.Int -> Prim.Int
operatorGuard = \v32 ->
  case v32 of
    (Just n)
      | (Pair a _) <- Pair n n -> a
    Nothing -> 0

operatorChainGuard :: Main.Maybe Prim.Int -> Main.Pair Prim.Int Prim.Int
operatorChainGuard = \v73 ->
  case v73 of
    (Just n)
      | (Pair a (Pair b _)) <- Pair n (Pair n n) -> Pair a b
    Nothing -> Pair 0 0

nestedOperatorGuard :: Main.Maybe Prim.Int -> Prim.Int
nestedOperatorGuard = \v125 ->
  case v125 of
    (Just n)
      | (Box (Pair a _)) <- Box (Pair n n) -> a
    Nothing -> 0

