@export foreign observe

@export foreign readTrace

@export withDefaults = \options%0 -> record.union options%0 { x: 1, y: "default" }

@export override = \record%1 -> record.union { x: 0 } record%1

@export union = \record%2 -> record.union record%2 { x: 1 }

@export disjointUnion = \record%3 -> record.union { x: 1 } record%3

@export literals = { y: "right", x: 1 }

@export withDefaultsOrder = \options%4 ->
  let
    record%5 = observe "options" options%4
  in record.union record%5 { x: observe "default" 1, y: "default" }

@export overrideOrder = \record%6 ->
  let
    x%7 = observe "override" 0
  in record.union { x: x%7 } (observe "record" record%6)

@export literalsOrder = \$boolean%10@(_) ->
  let
    x%8 = observe "left" 1
    x%9 = observe "right" 2
  in { y: "right", x: x%8 }

@export overrideBranchOrder = \record%11 ->
  record.union {
    y: observe "override" "y",
    x:
      case record%11.y of
        "branch" ->
          observe "branch" 1
        _ ->
          observe "fallback" 2
  } record%11
