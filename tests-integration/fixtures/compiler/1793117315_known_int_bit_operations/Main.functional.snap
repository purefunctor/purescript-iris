@export bitAnd = \left%0 right%1 -> integer.and left%0 right%1

@export bitOr = \left%2 right%3 -> integer.or left%2 right%3

@export bitXor = \left%4 right%5 -> integer.xor left%4 right%5

@export shiftLeft = \value%6 count%7 -> integer.shift_left value%6 count%7

@export shiftRight = \value%8 count%9 -> integer.shift_right value%8 count%9

@export zeroFillShiftRight = \value%10 count%11 -> integer.zero_fill_shift_right value%10 count%11

@export bitComplement = \value%12 -> integer.complement value%12

@export lowByte = \value%13 ->
  integer.or (integer.and value%13 255) (integer.and (integer.complement 0) 0)

@export partiallyAppliedAnd = and 15
