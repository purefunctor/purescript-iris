@export recovers = observe
  (\visited%36 ->
    effect.forRange
      0
      4
      (\index%37 ->
        catchException (\error%38 -> record visited%36 (string.append "caught " (message error%38)))
          (effect.bind (when applicativeEffect (integer.equal index%37 1) (throw "one"))
            \$unit%39 -> record visited%36 (showIntDictShow index%37))))

