Types
RowApply :: forall k. (Prim.Row k -> Prim.Row k) -> Prim.Row k -> Prim.Row k
+ :: forall k. (Prim.Row k -> Prim.Row k) -> Prim.Row k -> Prim.Row k
AddField :: Prim.Type -> Prim.Row Prim.Type -> Prim.Row Prim.Type
Bad :: Prim.Type -> Prim.Row Prim.Type
