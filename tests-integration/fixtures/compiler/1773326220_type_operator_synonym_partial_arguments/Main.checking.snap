Synonyms
type RowApply f a = (f :: Prim.Row k -> Prim.Row k) (a :: Prim.Row k)
type AddField a r = ( field :: a | (r :: Prim.Row Prim.Type) )
type Bad a = Main.RowApply @Prim.Type (Main.AddField a) ()
type Good a = Main.RowApply @Prim.Type (Main.AddField a) ()
