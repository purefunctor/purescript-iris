data Tuple :: Prim.Type -> Prim.Type -> Prim.Type
data Tuple @a @b
  | Tuple :: a -> b -> Main.Tuple a b

data Maybe :: Prim.Type -> Prim.Type
data Maybe @a
  | Just :: a -> Main.Maybe a
  | Nothing :: Main.Maybe a

complete :: forall t0 t1. Main.Tuple (Main.Maybe t0) (Main.Maybe t1) -> Prim.Int
complete = \v21 ->
  case v21 of
    (Tuple (Just _) (Just _)) -> 1
    (Tuple (Just _) Nothing) -> 2
    (Tuple Nothing (Just _)) -> 3
    (Tuple Nothing Nothing) -> 4

