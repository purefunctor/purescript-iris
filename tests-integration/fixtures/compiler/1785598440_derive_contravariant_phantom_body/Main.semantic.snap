data Constant :: forall k0. Prim.Type -> k0 -> Prim.Type
data Constant @value @a
  | Constant :: value -> Main.Constant value a

dictionary contravariantConstantType ::
  forall value.
  Data.Functor.Contravariant.Contravariant (Main.Constant @Prim.Type value)
  where
  cmap :: forall a b. (b -> a) -> Main.Constant @Prim.Type value a -> Main.Constant @Prim.Type value b
  cmap = \function value ->
    case value of
      (Constant field0) -> Constant field0
