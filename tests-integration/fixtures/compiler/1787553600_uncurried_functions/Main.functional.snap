@export foreign chooseSecond

@export made = uncurried \first%0, second%1 -> second%1

@export madeNested = uncurried \first%2, second%3, third%4 -> third%4

@export madeCaptured = \captured%7 -> uncurried \first%5, second%6 -> captured%7

@export madeWithCurriedResult = uncurried \first%8, second%9 -> \third%10 -> third%10

