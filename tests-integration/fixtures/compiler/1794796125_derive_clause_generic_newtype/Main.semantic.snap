  to :: Data.Generic.Rep.Sum
  (Data.Generic.Rep.Constructor "North" Data.Generic.Rep.NoArguments)
  (Data.Generic.Rep.Constructor "South" Data.Generic.Rep.NoArguments) ->
Main.Direction
  to = \representation ->
    case representation of
      (Inl (Constructor NoArguments)) -> North
      (Inr (Constructor NoArguments)) -> South
  from :: Main.Direction ->
Data.Generic.Rep.Sum
