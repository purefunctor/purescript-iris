@export instance both = \hasFirstServicesDict%0 hasSecondServicesDict%1 ->
  { "Has0": \() -> hasFirstServicesDict%0, "Has1": \() -> hasSecondServicesDict%1 }

@export reading = \bothServicesDict%2 ->
  \services%3 ->
    case (bothServicesDict%2."Has0"()).getService
      services%3, (bothServicesDict%2."Has1"()).getService services%3 of
      first%4, second%5 ->
        integer.add (integer.multiply first%4 100) second%5

@export readingValue = reading
  (both
    { getService: \environment%6 -> environment%6.first }
    { getService: \environment%7 -> environment%7.second })
  { first: 3, second: 7 }
