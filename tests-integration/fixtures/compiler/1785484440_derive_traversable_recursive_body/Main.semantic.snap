---
source: tests-integration/src/fixtures.rs
---
data Tree :: Prim.Type -> Prim.Type
data Tree @a
  | Leaf :: a -> Main.Tree a
  | Branch :: Main.Tree a -> Main.Tree a -> Main.Tree a

dictionary functorTree :: Data.Functor.Functor Main.Tree where
  map :: forall a b. (a -> b) -> Main.Tree a -> Main.Tree b
  map = \function value ->
    case value of
      (Leaf field0) -> Leaf (function field0)
      (Branch field0 field1) -> Branch (map {functorTree} (\element -> function element) field0)
        (map {functorTree} (\element -> function element) field1)

dictionary foldableTree :: Data.Foldable.Foldable Main.Tree where
  foldr :: forall a b. (a -> b -> b) -> b -> Main.Tree a -> b
  foldr = \function accumulator value ->
    case value of
      (Leaf field0) -> function field0 accumulator
      (Branch field0 field1) -> foldr {foldableTree}
        (\element accumulator -> function element accumulator)
        (foldr {foldableTree} (\element accumulator -> function element accumulator) accumulator
          field1)
        field0
  foldl :: forall a b. (b -> a -> b) -> b -> Main.Tree a -> b
  foldl = \function accumulator value ->
    case value of
      (Leaf field0) -> function accumulator field0
      (Branch field0 field1) -> foldl {foldableTree}
        (\accumulator element -> function accumulator element)
        (foldl {foldableTree} (\accumulator element -> function accumulator element) accumulator
          field0)
        field1
  foldMap :: forall a m. Data.Monoid.Monoid m => (a -> m) -> Main.Tree a -> m
  foldMap = \{monoidDict} ->
    \function value ->
      case value of
        (Leaf field0) -> function field0
        (Branch field0 field1) -> append {monoidDict.semigroupDict}
          (foldMap {foldableTree} {monoidDict} (\element -> function element) field0)
          (foldMap {foldableTree} {monoidDict} (\element -> function element) field1)

dictionary traversableTree :: Data.Traversable.Traversable Main.Tree where
  superclass functorDict = functorTree
  superclass foldableDict = foldableTree
  traverse :: forall a b (m :: Prim.Type -> Prim.Type).
  Control.Applicative.Applicative m => (a -> m b) -> Main.Tree a -> m (Main.Tree b)
  traverse = \{applicativeDict} ->
    \function value ->
      case value of
        (Leaf field0) -> map {applicativeDict.applyDict.functorDict}
          (\field0Result -> Leaf field0Result)
          (function field0)
        (Branch field0 field1) -> apply {applicativeDict.applyDict}
          (map {applicativeDict.applyDict.functorDict}
            (\field0Result field1Result -> Branch field0Result field1Result)
            (traverse {traversableTree} {applicativeDict} (\element -> function element) field0))
          (traverse {traversableTree} {applicativeDict} (\element -> function element) field1)
  sequence :: forall a (m :: Prim.Type -> Prim.Type).
  Control.Applicative.Applicative m => Main.Tree (m a) -> m (Main.Tree a)
  sequence = \{applicativeDict} ->
    \value -> traverse {traversableTree} {applicativeDict} (\effect0 -> effect0) value
