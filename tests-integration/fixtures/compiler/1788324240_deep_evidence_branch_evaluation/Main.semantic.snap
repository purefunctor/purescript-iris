data Proxy :: forall k. k -> Prim.Type
data Proxy @a
  | Proxy :: Main.Proxy a

interface Build :: Prim.Int -> Prim.Constraint
interface Build number where
  built :: Prim.Int

dictionary buildZero :: Main.Build 0 where
  built :: Prim.Int
  built = 0

dictionary buildNext ::
  forall previous current.
  { addDict :: Prim.Int.Add previous 1 current } =>
  { buildDict :: Main.Build previous } =>
  Main.Build current
  where
  built :: Prim.Int
  built = crash 0

foreign import crash :: Prim.Int -> Prim.Int

buildValue :: forall number. Main.Build number => Main.Proxy @Prim.Int number -> Prim.Int
buildValue = \{buildDict} -> \_ -> built {buildDict}

