@export integer = \$int%0 ->
  case $int%0 of
    0 ->
      true
    _ ->
      false

@export number = \$number%1 ->
  case $number%1 of
    1.5 ->
      true
    _ ->
      false

@export character = \$char%2 ->
  case $char%2 of
    'a' ->
      true
    _ ->
      false

@export escapedDoubleQuote = '"'

@export matchesEscapedDoubleQuote = \$char%3 ->
  case $char%3 of
    '"' ->
      true
    _ ->
      false

@export string = \$string%4 ->
  case $string%4 of
    "iris" ->
      true
    _ ->
      false

@export boolean = \$boolean%5 ->
  case $boolean%5 of
    true ->
      true
    false ->
      false
