data Proxy :: forall k. k -> Prim.Type
data Proxy @a
  | Proxy :: Main.Proxy a

interface Top :: Prim.Type -> Prim.Constraint
interface Top a where
  top :: a

dictionary topProxy :: forall t0 a. Main.Top (Main.Proxy @t0 a) where
  top :: Main.Proxy @t0 a
  top = Proxy
