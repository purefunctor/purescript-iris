---
source: tests-integration/src/fixtures.rs
---
@export foreign constructEffect

@export branched = \choose%2 seed%0 ->
  effect.bind (constructEffect "branch-action" seed%0)
    \value%1 -> if choose%2
      then constructEffect "branch-then" value%1
      else constructEffect "branch-else" value%1

@export patternLet = \seed%3 ->
  effect.bind (constructEffect "pattern-action" seed%3)
    \value%4 -> let
      { selected: selected%5 } = { selected: value%4 }
    in constructEffect "pattern-result" selected%5
