data M :: Prim.Row Prim.Type -> Prim.Type -> Prim.Type
data M @context @a
  | M :: a -> Main.M context a

interface Ask :: Prim.Row Prim.Type -> (Prim.Type -> Prim.Type) -> Prim.Constraint
interface Ask context m where
  ask :: m {| context }

interface Produce :: Prim.Row Prim.Type -> Prim.Row Prim.Type -> Prim.Row Prim.Type -> Prim.Constraint
interface Produce context input output where
  produce :: {| context } -> {| input } -> {| output }

foreign import unsafeCoerce :: forall a b. a -> b

bind :: forall context a b. Main.M context a -> (a -> Main.M context b) -> Main.M context b
bind = \(M a) -> \f -> f a

dictionary askM :: forall context. Main.Ask context (Main.M context) where
  ask :: Main.M context {| context }
  ask = unsafeCoerce (M { })

consume :: forall row list. Prim.RowList.RowToList @Prim.Type row list => {| row } -> {}
consume = \{rowToListDict} -> \_ -> { }

dictionary produce1 ::
  forall input inputList context.
  { rowToListDict :: Prim.RowList.RowToList @Prim.Type input inputList } =>
  Main.Produce context input input
  where
  produce :: {| context } -> {| input } -> {| input }
  produce = \_ -> \input -> input

test :: forall context input output outputList.
  Prim.RowList.RowToList @Prim.Type output outputList =>
  Main.Produce context input output =>
  {| input } -> Main.M context {}
test = \{rowToListDict} -> \{produceDict} -> \input ->
  bind (ask {askM}) \context ->
    let
      output :: {| output }
      output = produce {produceDict} context input
    in
      M (consume {rowToListDict} output)
