data WrapBoth :: forall k0 k1. (k0 -> Prim.Type) -> (k1 -> Prim.Type) -> k0 -> k1 -> Prim.Type
data WrapBoth @f @g @a @b
  | WrapBoth :: f a -> g b -> Main.WrapBoth f g a b

data WrapBothNoConstraint ::
  forall k0 k1. (k0 -> Prim.Type) -> (k1 -> Prim.Type) -> k0 -> k1 -> Prim.Type
data WrapBothNoConstraint @f @g @a @b
  | WrapBothNoConstraint :: f a -> g b -> Main.WrapBothNoConstraint f g a b

dictionary bifoldableWrapBothTypeType ::
  forall f g.
  { foldableDict :: Data.Foldable.Foldable f } =>
  { foldableDict1 :: Data.Foldable.Foldable g } =>
  Data.Bifoldable.Bifoldable (Main.WrapBoth @Prim.Type @Prim.Type f g)
  where
  bifoldr :: forall a b c.
  (a -> c -> c) -> (b -> c -> c) -> c -> Main.WrapBoth @Prim.Type @Prim.Type f g a b -> c
  bifoldr = \firstFunction secondFunction accumulator value ->
    case value of
      (WrapBoth field0 field1) -> foldr {foldableDict}
        (\element accumulator -> firstFunction element accumulator)
        (foldr {foldableDict1} (\element accumulator -> secondFunction element accumulator)
          accumulator
          field1)
        field0
  bifoldl :: forall a b c.
  (c -> a -> c) -> (c -> b -> c) -> c -> Main.WrapBoth @Prim.Type @Prim.Type f g a b -> c
  bifoldl = \firstFunction secondFunction accumulator value ->
    case value of
      (WrapBoth field0 field1) -> foldl {foldableDict1}
        (\accumulator element -> secondFunction accumulator element)
        (foldl {foldableDict} (\accumulator element -> firstFunction accumulator element)
          accumulator
          field0)
        field1
  bifoldMap :: forall m a b.
  Data.Monoid.Monoid m => (a -> m) -> (b -> m) -> Main.WrapBoth @Prim.Type @Prim.Type f g a b -> m
  bifoldMap = \{monoidDict} ->
    \firstFunction secondFunction value ->
      case value of
        (WrapBoth field0 field1) -> append {monoidDict.semigroupDict}
          (foldMap {foldableDict} {monoidDict} (\element -> firstFunction element) field0)
          (foldMap {foldableDict1} {monoidDict} (\element -> secondFunction element) field1)
