data Proxy :: forall k0. k0 -> Prim.Type
data Proxy @a
  | Proxy :: Main.Proxy a

data NoEq :: Prim.Type
data NoEq
  | MkNoEq :: Main.NoEq

data ContainsNoEq :: Prim.Type
data ContainsNoEq
  | MkContainsNoEq :: Main.NoEq -> Main.ContainsNoEq

dictionary eqProxy :: forall t0 a. Data.Eq.Eq (Main.Proxy @t0 a) where
  eq :: Main.Proxy @t0 a -> Main.Proxy @t0 a -> Prim.Boolean
  eq = \left right ->
    case left, right of
      Proxy, Proxy -> true
