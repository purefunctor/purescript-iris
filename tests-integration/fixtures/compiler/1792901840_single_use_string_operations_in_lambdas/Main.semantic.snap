sharedAppend :: Prim.String -> Data.Unit.Unit -> Prim.String
sharedAppend = \value ->
  let
    doubled :: Prim.String
    doubled = append {semigroupString} value value
  in
    \_ -> doubled

sharedEqual :: Prim.String -> Prim.String -> Prim.Int -> Prim.Int
sharedEqual = \left -> \right ->
  let
    matches :: Prim.Boolean
    matches = eq {eqString} left right
  in
    \value ->
      if matches then value else 0
