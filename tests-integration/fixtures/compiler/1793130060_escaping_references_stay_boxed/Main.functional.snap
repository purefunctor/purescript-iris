@export bump = \ref%1 -> effect.modifyReference (\section41%0 -> integer.add section41%0 1) ref%1

@export passed = effect.bind (effect.newReference 0)
  \ref%2 -> effect.bind (bump ref%2)
    \$unit%3 -> effect.bind (effect.modifyReference
      (\section75%4 -> integer.add section75%4 10)
      ref%2)
      \$unit%5 -> effect.readReference ref%2

@export returned = effect.bind (effect.newReference 1)
  \ref%6 -> effect.bind (effect.writeReference 2 ref%6) \$unit%7 -> effect.pure ref%6

@export stored = effect.bind (effect.newReference 3)
  \ref%8 -> effect.bind (effect.modifyReference
    (\section146%9 -> integer.multiply section146%9 2)
    ref%8)
    \$unit%10 -> effect.pure { counter: ref%8 }

@export captured = \flag%12 ->
  effect.bind (effect.newReference 0)
    \ref%11 -> effect.bind (when applicativeEffect flag%12
      (effect.modifyReference (\section192%13 -> integer.add section192%13 5) ref%11))
      \$unit%14 -> effect.bind (if flag%12
        then effect.modifyReference (\section209%15 -> integer.multiply section209%15 2) ref%11
        else effect.pure unit)
        \$unit%16 -> let
          increment%17 = effect.modifyReference
            (\section231%20 -> integer.add section231%20 1)
            ref%11
        in effect.bind increment%17
          \$unit%18 -> effect.bind increment%17 \$unit%19 -> effect.readReference ref%11
