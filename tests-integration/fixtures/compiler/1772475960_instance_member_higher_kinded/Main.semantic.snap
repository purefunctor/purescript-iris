interface Functor :: (Prim.Type -> Prim.Type) -> Prim.Constraint
interface Functor f where
  map :: forall a b. (a -> b) -> f a -> f b

newtype Wrap :: forall k. Prim.Type -> (k -> Prim.Type) -> k -> Prim.Type
newtype Wrap @e @w @a
  | Wrap :: w a -> Main.Wrap e w a

dictionary functorWrapType ::
  forall w e.
  { functorDict :: Main.Functor w } =>
  Main.Functor (Main.Wrap @Prim.Type e w)
  where
  map :: forall a b. (a -> b) -> Main.Wrap @Prim.Type e w a -> Main.Wrap @Prim.Type e w b
  map = \f -> \(Wrap x) -> Wrap (map {functorDict} f x)
