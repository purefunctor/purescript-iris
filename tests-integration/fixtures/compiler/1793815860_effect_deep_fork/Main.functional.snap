recursive[0] nestedForks = \depth%0 ->
  \environment%7 ->
    {
      tag: "Run",
      _1:
        uncurried \ ->
          if integer.equal depth%0 0
            then uncurried.call effect.pure { tag: "Pure", _1: 719 }()
            else let
              asyncArgument%5 = fork (nestedForks (integer.subtract depth%0 1))
            in uncurried.call effect.pure {
              tag: "Bind",
              _1: asyncArgument%5 environment%7,
              _2: \child%4 -> join child%4 environment%7
            }()
    }

recursive[1] countdown = \remaining%8 ->
  if integer.equal remaining%8 0
    then \environment%9 -> { tag: "Pure", _1: 0 }
    else \environment%17 ->
      {
        tag: "Run",
        _1:
          uncurried \ ->
            let
              asyncArgument%15 = countdown (integer.subtract remaining%8 1)
            in uncurried.call effect.pure {
              tag: "Bind",
              _1: asyncArgument%15 environment%17,
              _2: \next%12 -> { tag: "Pure", _1: integer.add next%12 1 }
            }()
      }

program = \report%19 ->
  let
    asyncArgument%29 = nestedForks 10000
  in \environment%30 ->
    {
      tag: "Run",
      _1:
        uncurried \ ->
          uncurried.call effect.pure {
            tag: "Bind",
            _1: asyncArgument%29 environment%30,
            _2:
              \forked%18 ->
                {
                  tag: "Run",
                  _1:
                    uncurried \ ->
                      let
                        asyncArgument%20 = report%19
                          (string.append "nested forks " (showIntDictShow forked%18))
                      in uncurried.call effect.bind asyncArgument%20
                        \$unit%22 -> let
                          asyncArgument%26 = countdown 100000
                        in effect.pure {
                          tag: "Bind",
                          _1: asyncArgument%26 environment%30,
                          _2:
                            \counted%23 ->
                              {
                                tag: "Run",
                                _1:
                                  uncurried \ ->
                                    let
                                      asyncArgument%24 = report%19
                                        (string.append "binds " (showIntDictShow counted%23))
                                    in uncurried.call effect.bind asyncArgument%24
                                      \value%33 -> effect.pure { tag: "Pure", _1: value%33 }()
                              }
                        }()
                }
          }()
    }

@export run = \report%32 ->
  void functorEffect
    (launch { onUncaught: \error%31 -> report%32 (string.append "uncaught " error%31) } {  }
      (program report%32))

showIntDictShow = show showInt
