---
source: tests-integration/src/fixtures.rs
---
newtype App :: forall k. (k -> Prim.Type) -> k -> Prim.Type
newtype App @f @a
  | App :: f a -> Main.App f a

dictionary newtypeApp :: forall t0 f a. Data.Newtype.Newtype (Main.App @t0 f a) (f a) where
  superclass coercibleDict = trivial

dictionary eqAppType ::
  forall f a.
  { eq1Dict :: Data.Eq.Eq1 f } =>
  { eqDict :: Data.Eq.Eq a } =>
  Data.Eq.Eq (Main.App @Prim.Type f a)
  where
  eq :: Main.App @Prim.Type f a -> Main.App @Prim.Type f a -> Prim.Boolean
  eq = \left right ->
    case left, right of
      (App left0), (App right0) ->
        if eq1 {eq1Dict} {eqDict} left0 right0 then true else false

dictionary eq1AppType ::
  forall f.
  { eq1Dict :: Data.Eq.Eq1 f } =>
  Data.Eq.Eq1 (Main.App @Prim.Type f)
  where
  eq1 :: forall a. Data.Eq.Eq a => Main.App @Prim.Type f a -> Main.App @Prim.Type f a -> Prim.Boolean
  eq1 = \{eqDict} -> eq {eqAppType {eq1Dict} {eqDict}}

dictionary ordAppType ::
  forall f a.
  { ord1Dict :: Data.Ord.Ord1 f } =>
  { ordDict :: Data.Ord.Ord a } =>
  Data.Ord.Ord (Main.App @Prim.Type f a)
  where
  superclass eqDict = eqAppType {ord1Dict.eq1Dict} {ordDict.eqDict}
  compare :: Main.App @Prim.Type f a -> Main.App @Prim.Type f a -> Data.Ordering.Ordering
  compare = \left right ->
    case left, right of
      (App left0), (App right0) ->
        case compare1 {ord1Dict} {ordDict} left0 right0 of
          EQ -> EQ
          ordering -> ordering

dictionary ord1AppType ::
  forall f.
  { ord1Dict :: Data.Ord.Ord1 f } =>
  Data.Ord.Ord1 (Main.App @Prim.Type f)
  where
  superclass eq1Dict = eq1AppType {ord1Dict.eq1Dict}
  compare1 :: forall a.
  Data.Ord.Ord a => Main.App @Prim.Type f a -> Main.App @Prim.Type f a -> Data.Ordering.Ordering
  compare1 = \{ordDict} -> compare {ordAppType {ord1Dict} {ordDict}}
