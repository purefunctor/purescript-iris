    Main.Compose @t0 @t1 (f :: t0 -> Prim.Type) (g :: t1 -> t0) (a :: t1)
Left' :: forall @a. a -> Main.Either' a
Right' :: forall @a. a -> Main.Either' a
NoEq :: forall @a. a -> Main.NoEq a

