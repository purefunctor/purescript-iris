  to:
    \representation%0 ->
      case representation%0 of
        field0%1 ->
          { tag: "Wrapper", _1: field0%1 },
  from:
    \value%2 ->
      case value%2 of
        Wrapper field0%3 ->
          field0%3
}

@export instance genericOpaqueNoConstructors = {
