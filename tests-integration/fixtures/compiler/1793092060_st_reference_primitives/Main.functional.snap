@export results = run
  (effect.bind (new 1)
    \ref%0 -> effect.bind (write 2 ref%0)
      \written%1 -> effect.bind (modify (\section63%2 -> integer.add section63%2 10) ref%0)
        \modified%3 -> effect.bind (modify'
          (\state%4 -> { state: integer.multiply state%4 2, value: show showInt state%4 })
          ref%0)
          \modifiedValue%5 -> effect.bind (read ref%0)
            \final%6 -> effect.pure {
              written: written%1,
              modified: modified%3,
              modifiedValue: modifiedValue%5,
              final: final%6
            })
