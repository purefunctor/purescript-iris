interface BuildRecord :: Prim.Row Prim.Type -> Prim.Row Prim.Type -> Prim.Constraint
interface BuildRecord row subrow where
  buildIt :: {| subrow }

foreign import unsafeSet :: forall r1 r2 a. Prim.String -> a -> {| r1 } -> {| r2 }

dictionary buildRecordImpl :: forall row subrow. Main.BuildRecord row subrow where
  buildIt :: {| subrow }
  buildIt = result
    where
    result :: {| subrow }
    result = unsafeSet "x" 42 { }

test :: forall r s. Main.BuildRecord r s => {| s }
test = \{buildRecordDict} -> buildIt {buildRecordImpl}
