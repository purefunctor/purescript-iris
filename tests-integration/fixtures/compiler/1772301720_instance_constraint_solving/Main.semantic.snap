interface Eq :: Prim.Type -> Prim.Constraint
interface Eq a where
  eq :: a -> a -> Prim.Boolean

dictionary eqInt :: Main.Eq Prim.Int where
  eq :: Prim.Int -> Prim.Int -> Prim.Boolean
  eq = \_ -> \_ -> true

dictionary eqArray :: forall a. { eqDict :: Main.Eq a } => Main.Eq (Prim.Array a) where
  eq :: Prim.Array a -> Prim.Array a -> Prim.Boolean
  eq = \_ -> \_ -> false

test :: Prim.Boolean
test = eq {eqInt} 1 2

test2 :: Prim.Boolean
test2 = eq {eqArray {eqInt}} [1] [2]

test3 :: forall t0. Main.Eq t0 => t0 -> t0 -> Prim.Boolean
test3 = \{eqDict} -> \x -> \y -> eq {eqDict} x y
