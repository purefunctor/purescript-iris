---
source: tests-integration/src/fixtures.rs
---
animation :: Iris.StyleX.Keyframes
animation = keyframes { from: { opacity: 0.0 }, to: { opacity: 1.0 } }

styles :: { button :: Iris.StyleX.Style, label :: Iris.StyleX.Style }
styles =
  create {compileStyles {trivial} {compileStyleListConsTypeRecord {compileStyleListConsTypeRecord {compileStyleListNilTypeRow} {trivial}} {trivial}}}
    { button: { color: "red", padding: 8, marginInline: negate {ringInt}
      20, opacity: negate {ringNumber}
      0.5, animationName: animation, :hover: { color: "blue" } }, label: { fontWeight: 600 } }

secondary :: { root :: Iris.StyleX.Style }
secondary =
  create {compileStyles {trivial} {compileStyleListConsTypeRecord {compileStyleListNilTypeRow} {trivial}}}
    { root: { backgroundColor: "navy" } }

buttonProps :: Iris.StyleX.Props
buttonProps = props {propsInputStyle} styles.button

styleProps :: { button :: Iris.StyleX.Props, label :: { className :: Prim.String } }
styleProps =
  recordProps {compileProps {trivial} {compilePropsListConsTypeStyle {compilePropsListConsTypeStyle {compilePropsListNilTypeRow} {trivial}} {trivial}}}
    styles

appliedStyleProps :: { button :: Iris.StyleX.Props, label :: { className :: Prim.String } }
appliedStyleProps =
  apply
    (recordProps {compileProps {trivial} {compilePropsListConsTypeStyle {compilePropsListConsTypeStyle {compilePropsListNilTypeRow} {trivial}} {trivial}}})
    styles

flippedStyleProps :: { button :: Iris.StyleX.Props, label :: { className :: Prim.String } }
flippedStyleProps =
  applyFlipped styles
    (recordProps {compileProps {trivial} {compilePropsListConsTypeStyle {compilePropsListConsTypeStyle {compilePropsListNilTypeRow} {trivial}} {trivial}}})

buttonPropsArray :: Prim.Boolean -> Iris.StyleX.Props
buttonPropsArray = \highlighted ->
  props {propsInputArrayStyle} [styles.button, conditional highlighted secondary.root]

selectedProps :: Prim.Boolean -> Prim.Boolean -> Iris.StyleX.Props
selectedProps = \included -> \alternate ->
  props {propsInputStyle} (conditional included if alternate then styles.button else styles.label)

buttonClassName :: Prim.String
buttonClassName = buttonProps.className

labelClassName :: Prim.String
labelClassName = styleProps.label.className
