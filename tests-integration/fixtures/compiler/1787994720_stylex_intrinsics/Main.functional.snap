---
source: tests-integration/src/fixtures.rs
---
@export animation = stylex.keyframes { from: { opacity: 0.0 }, to: { opacity: 1.0 } }

@export styles = stylex.create {
  button:
    {
      color: "red",
      padding: 8,
      marginInline: -20,
      opacity: -0.5,
      animationName: animation,
      ":hover": { color: "blue" }
    },
  label: { fontWeight: 600 }
}

@export secondary = stylex.create { root: { backgroundColor: "navy" } }

@export buttonProps = stylex.props styles.button

@export styleProps = { button: stylex.props styles.button, label: stylex.props styles.label }

@export appliedStyleProps = { button: stylex.props styles.button, label: stylex.props styles.label }

@export flippedStyleProps = { button: stylex.props styles.button, label: stylex.props styles.label }

@export buttonPropsArray = \highlighted%0 ->
  stylex.props [styles.button, stylex.conditional highlighted%0 secondary.root]

@export selectedProps = \included%1 alternate%2 ->
  stylex.props (stylex.conditional included%1 (if alternate%2 then styles.button else styles.label))

@export buttonClassName = buttonProps.className

@export labelClassName = styleProps.label.className
