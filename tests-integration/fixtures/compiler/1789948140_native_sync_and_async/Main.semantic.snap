foreign import mark :: Prim.String -> Prim.Int -> Iris.Effect.Sync [] Prim.Int

foreign import delayed :: Prim.Int -> Iris.Effect.Async [] Prim.Int

syncProgram :: Iris.Effect.Sync [] Prim.Int
syncProgram =
  bind {trivial} (mark "first" 20) \first ->
    bind {trivial} (mark "second" 22) \second -> pure (add {semiringInt} first second)

wrappedProgram :: Iris.Effect.Sync [] Prim.Int
wrappedProgram = pure 21

asyncProgram :: Iris.Effect.Async [] Prim.Int
asyncProgram =
  bind {trivial} (lift syncProgram) \value -> discard {trivial} yield \_ -> delayed value

deep :: Prim.Int -> Prim.Int -> Iris.Effect.Async [] Prim.Int
deep = \remaining -> \total ->
  if eq {eqInt} remaining 0 then
    pure total
  else
    defer \_ -> deep (sub {ringInt} remaining 1) (add {semiringInt} total 1)

main :: Iris.Effect.Sync [] (Iris.Effect.Fiber Prim.Int)
main = run asyncProgram

runDeep :: Iris.Effect.Sync [] (Iris.Effect.Fiber Prim.Int)
runDeep = run (deep 100000 0)

