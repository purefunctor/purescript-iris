interface Build :: (Prim.Type -> Prim.Type) -> Prim.Constraint
interface Build f where
  singleton :: forall a. a -> f a
  produce :: forall a b. (b -> a) -> b -> f a

identity :: forall a. a -> a
identity = \x -> x

test :: forall f. Main.Build f => Prim.Boolean -> Prim.Boolean -> f Prim.Boolean
test = \{buildDict} ->
  \v62 v63 ->
    case v62, v63 of
      from, to
        | from -> singleton {buildDict} true
        | to -> produce {buildDict} identity true
        | true -> produce {buildDict} identity false
