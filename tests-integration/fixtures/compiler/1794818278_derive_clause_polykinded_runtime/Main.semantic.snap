data Phantom :: forall k0. k0 -> Prim.Type
data Phantom @a
  | Phantom :: Prim.Int -> Main.Phantom a

dictionary eq1PhantomType :: Data.Eq.Eq1 (Main.Phantom @Prim.Type) where
  eq1 :: forall a. Data.Eq.Eq a => Main.Phantom @Prim.Type a -> Main.Phantom @Prim.Type a -> Prim.Boolean
  eq1 = \{eqDict} -> eq {eqPhantom}

dictionary ord1PhantomType :: Data.Ord.Ord1 (Main.Phantom @Prim.Type) where
  superclass eq1Dict = eq1PhantomType
  compare1 :: forall a.
  Data.Ord.Ord a => Main.Phantom @Prim.Type a -> Main.Phantom @Prim.Type a -> Data.Ordering.Ordering
  compare1 = \{ordDict} -> compare {ordPhantom}

dictionary functorPhantomType :: Data.Functor.Functor (Main.Phantom @Prim.Type) where
  map :: forall a b. (a -> b) -> Main.Phantom @Prim.Type a -> Main.Phantom @Prim.Type b
  map = \function value ->
    case value of
      (Phantom field0) -> Phantom field0

dictionary foldablePhantomType :: Data.Foldable.Foldable (Main.Phantom @Prim.Type) where
  foldr :: forall a b. (a -> b -> b) -> b -> Main.Phantom @Prim.Type a -> b
  foldr = \function accumulator value ->
    case value of
      (Phantom field0) -> accumulator
  foldl :: forall a b. (b -> a -> b) -> b -> Main.Phantom @Prim.Type a -> b
  foldl = \function accumulator value ->
    case value of
      (Phantom field0) -> accumulator
  foldMap :: forall a m. Data.Monoid.Monoid m => (a -> m) -> Main.Phantom @Prim.Type a -> m
  foldMap = \{monoidDict} ->
    \function value ->
      case value of
        (Phantom field0) -> mempty {monoidDict}

dictionary traversablePhantomType :: Data.Traversable.Traversable (Main.Phantom @Prim.Type) where
  superclass functorDict = functorPhantomType
  superclass foldableDict = foldablePhantomType
  traverse :: forall a b (m :: Prim.Type -> Prim.Type).
  Control.Applicative.Applicative m =>
  (a -> m b) -> Main.Phantom @Prim.Type a -> m (Main.Phantom @Prim.Type b)
  traverse = \{applicativeDict} ->
