dictionary eqPhantom :: forall t0 a. Data.Eq.Eq (Main.Phantom @t0 a) where
  eq :: Main.Phantom @t0 a -> Main.Phantom @t0 a -> Prim.Boolean
  eq = \left right ->
    case left, right of
      (Phantom left0), (Phantom right0) ->
        if eq {eqInt} left0 right0 then true else false

dictionary ordPhantom :: forall t0 a. Data.Ord.Ord (Main.Phantom @t0 a) where
  superclass eqDict = eqPhantom
  compare :: Main.Phantom @t0 a -> Main.Phantom @t0 a -> Data.Ordering.Ordering
  compare = \left right ->
    case left, right of
      (Phantom left0), (Phantom right0) ->
        case compare {ordInt} left0 right0 of
          EQ -> EQ
          ordering -> ordering

mapped :: Prim.Int
mapped =
  case map {functorPhantomType} (\v79 -> add {semiringInt} v79 2) (Phantom 13) of
    (Phantom n) -> n

folded :: Prim.Int
folded = foldl {foldablePhantomType} (sub {ringInt}) 17 (Phantom 13)

traversed :: Prim.Int
traversed =
  case traverse {traversablePhantomType} {applicativeMaybe} (\n -> Just (add {semiringInt} n 1))
    (Phantom 13) of
    (Just (Phantom n)) -> n
    Nothing -> 0

contramapped :: Prim.Int
contramapped =
  case cmap {contravariantPhantomType} (\v183 -> add {semiringInt} v183 2) (Phantom 13) of
    (Phantom n) -> n

equal :: Prim.Boolean
equal = eq1 {eq1PhantomType} {eqInt} (Phantom 13) (Phantom 14)

ordered :: Prim.Boolean
ordered = eq {eqOrdering} (compare1 {ord1PhantomType} {ordInt} (Phantom 13) (Phantom 14)) LT
