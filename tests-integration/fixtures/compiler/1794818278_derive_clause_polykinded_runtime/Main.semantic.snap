dictionary contravariantPhantomType ::
  Data.Functor.Contravariant.Contravariant (Main.Phantom @Prim.Type)
  where
  cmap :: forall a b. (b -> a) -> Main.Phantom @Prim.Type a -> Main.Phantom @Prim.Type b
