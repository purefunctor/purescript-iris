data Map :: Prim.Type -> Prim.Type -> Prim.Type
data Map @key @value
  | Map :: Main.Map key value

newtype Set :: Prim.Type -> Prim.Type
newtype Set @value
  | Set :: Main.Map value Data.Unit.Unit -> Main.Set value

foreign import filterKeys :: forall key. (key -> Prim.Boolean) -> (forall value. Main.Map key value -> Main.Map key value)

filter :: forall value. (value -> Prim.Boolean) -> Main.Set value -> Main.Set value
filter = coerce {trivial} filterKeys
