@export merge = \record%0 ->
  build (merge <trivial evidence> <trivial evidence> { x: 0, z: true }) record%0

@export union = \record%1 -> build (union <trivial evidence> { z: true }) record%1

@export disjointUnion = \record%2 ->
  build (disjointUnion <trivial evidence> <trivial evidence> { z: true }) record%2

@export records = \left%3 right%4 ->
  build (merge <trivial evidence> <trivial evidence> left%3) right%4

@export literals = build (merge <trivial evidence> <trivial evidence> { x: 0 }) { y: "y", x: 1 }

@export insertThenMerge = \record%5 ->
  build
    (composeFlipped semigroupoidBuilder
      (insert <trivial evidence> <trivial evidence> (symbol "z") "Proxy" true)
      (merge <trivial evidence> <trivial evidence> { x: 0 }))
    record%5
