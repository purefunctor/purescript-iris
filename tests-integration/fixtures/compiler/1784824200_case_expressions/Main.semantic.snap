---
source: tests-integration/src/fixtures.rs
---
data Choice :: Prim.Type -> Prim.Type
data Choice @a
  | Empty :: Main.Choice a
  | One :: a -> Main.Choice a
  | Pair :: a -> a -> Main.Choice a

checked :: Main.Choice Prim.Int -> Prim.Int
checked = \choice ->
  case choice of
    Empty -> 0
    (One value) -> value
    (Pair left _) -> left

inferred :: Main.Choice Prim.Int -> Prim.Int
inferred = \choice ->
  case choice of
    Empty -> 0
    (One value) -> value
    (Pair left _) -> left

multiple :: Main.Choice Prim.Int -> Main.Choice Prim.Int -> Prim.Int
multiple = \first -> \second ->
  case first, second of
    (One left), (One _) -> left
    (Pair left _), _ -> left
    _, (One right) -> right
    _, _ -> 0

partial :: forall t0. Prim.Partial => Main.Choice t0 -> t0
partial = \{partialDict} -> \choice ->
  case choice of
    (One value) -> value
