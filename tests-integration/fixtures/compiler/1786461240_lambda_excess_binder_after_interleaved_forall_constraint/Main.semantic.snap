data Unit :: Prim.Type
data Unit
  | Unit :: Main.Unit

data Proxy :: Prim.Type -> Prim.Type
data Proxy @value
  | Proxy :: Main.Proxy value

interface Marker :: Prim.Type -> Prim.Constraint
interface Marker value where

foreign import consume :: (Main.Unit -> (forall value. Main.Marker value => Main.Proxy value)) -> Main.Unit

test :: Main.Unit
test = consume \_ -> \{markerDict} -> \extra -> Proxy
