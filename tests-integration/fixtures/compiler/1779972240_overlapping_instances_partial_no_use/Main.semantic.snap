data Pair :: Prim.Type -> Prim.Type -> Prim.Type
data Pair @a @b
  | Pair :: a -> b -> Main.Pair a b

interface Test :: Prim.Type -> Prim.Constraint
interface Test a where
  test :: a -> Prim.Int

dictionary testLeft :: forall a. Main.Test (Main.Pair a Prim.Int) where
  test :: Main.Pair a Prim.Int -> Prim.Int
  test = \_ -> 0

dictionary testRight :: forall b. Main.Test (Main.Pair Prim.String b) where
  test :: Main.Pair Prim.String b -> Prim.Int
  test = \_ -> 1
