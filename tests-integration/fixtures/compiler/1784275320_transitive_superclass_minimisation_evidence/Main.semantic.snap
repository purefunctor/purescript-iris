---
source: tests-integration/src/fixtures.rs
---
interface Bottom :: forall k0. k0 -> Prim.Constraint
interface Bottom a where

interface Middle :: forall k0. k0 -> Prim.Constraint
interface Middle a where
  superclass bottomDict :: Main.Bottom @t0 a

interface Top :: forall k0. k0 -> Prim.Constraint
interface Top a where
  superclass middleDict :: Main.Middle @t0 a

foreign import useBottom :: forall a. Main.Bottom @Prim.Type a => a -> Prim.Int

foreign import useMiddle :: forall a. Main.Middle @Prim.Type a => a -> Prim.Int

foreign import useTop :: forall a. Main.Top @Prim.Type a => a -> Prim.Int

test :: forall t0. Main.Top @Prim.Type t0 => t0 -> Prim.Int
test = \{topDict} -> \value ->
  let
    _ = useTop {topDict} value
    _ = useMiddle {topDict.middleDict} value
  in
    useBottom {topDict.middleDict.bottomDict} value
