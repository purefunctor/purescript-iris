@export foreign observe

@export foreign readTrace

@export flipped = \record%1 ->
  let
    value%2 = observe "y" "y"
    modify%3 = observe "modify" (\x%0 -> observe "apply" (integer.add x%0 1))
    z%4 = observe "z" true
    record%5 = observe "record" record%1
  in record.union { z: z%4 } (let
    record%6 = record%5 { y = value%2 }
  in record%6 { x = modify%3 record%6.x })

@export composed = \record%8 ->
  let
    value%9 = observe "y" "y"
    record%11 = observe "record" record%8
  in record%11 { x = (\x%7 -> observe "apply" (integer.add x%7 1)) record%11.x, y = value%9 }

@export literal = \$boolean%20@(_) ->
  let
    x%16 = observe "x" 1
    y%17 = observe "y" 2
    z%18 = observe "z" 3
  in record.delete z (let
    record%19 = { x: x%16, y: (\y%12 -> observe "first" (integer.add y%12 1)) y%17, z: z%18 }
  in record%19 { x = (\x%13 -> observe "second" (integer.add x%13 1)) record%19.x })
