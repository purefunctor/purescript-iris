data Maybe :: Prim.Type -> Prim.Type
data Maybe @a
  | Just :: a -> Main.Maybe a
  | Nothing :: Main.Maybe a

nonRecordGuard :: Main.Maybe Prim.Int -> Prim.Int
nonRecordGuard = \v21 ->
  case v21 of
    (Just n)
      | { value: (Just v) } <- n -> v
    Nothing -> 0

