---
source: tests-integration/src/fixtures.rs
---
foreign import setTimeout :: Prim.Int -> Effect.Effect Data.Unit.Unit -> Effect.Effect Prim.Int

foreign import clearTimeout :: Prim.Int -> Effect.Effect Data.Unit.Unit

say :: Main.Report -> Prim.String -> Iris.Effect.Async.Async Prim.String () Data.Unit.Unit
say = \report -> \message -> liftEffect (report message)

sleep :: Main.Report -> Prim.Int -> Iris.Effect.Async.Async Prim.String () Data.Unit.Unit
sleep = \report -> \milliseconds ->
  async \callback ->
    bind {bindEffect} (setTimeout milliseconds (callback (Right unit))) \identifier ->
      pure {applicativeEffect}
        (applySecond {applyAsync} (say report "canceler") (liftEffect (clearTimeout identifier)))

describe :: Iris.Effect.Fiber.Exit Prim.String Data.Unit.Unit -> Prim.String
describe = \v159 ->
  case v159 of
    (Succeeded _) -> "succeeded"
    (Failed error) -> append {semigroupString} "failed " error
    (Died _) -> "died"

program :: Main.Report -> Iris.Effect.Async.Async Prim.String () Data.Unit.Unit
program = \report ->
  bind {bindAsync}
    (fork (applySecond {applyAsync} (sleep report 1000) (say report "woke"))) \sleeping ->
    discard {discardUnit} {bindAsync} (say report "forked") \_ ->
      discard {discardUnit} {bindAsync} (kill "stop" sleeping) \_ ->
        discard {discardUnit} {bindAsync} (say report "killed") \_ ->
          bind {bindAsync} (await sleeping) \sleepingExit ->
            discard {discardUnit} {bindAsync}
              (say report (append {semigroupString} "sleeping " (describe sleepingExit))) \_ ->
              bind {bindAsync} (fork (pure {applicativeAsync} unit)) \finished ->
                bind {bindAsync} (await finished) \_ ->
                  discard {discardUnit} {bindAsync} (kill "too late" finished) \_ ->
                    bind {bindAsync} (await finished) \finishedExit ->
                      discard {discardUnit} {bindAsync}
                        (say report
                          (append {semigroupString} "finished " (describe finishedExit))) \_ ->
                        discard {discardUnit} {bindAsync} (sleep report 20) \_ -> say report "done"

run :: Main.Report -> Effect.Effect Data.Unit.Unit
run = \report ->
  void {functorEffect}
    (launch { onUncaught: \error -> report (append {semigroupString} "uncaught " error) } { }
      (program report))
