@export foreign firstAction

@export foreign secondAction

@export foreign independentAction

@export sequential = effect.bind firstAction \first%0 -> secondAction first%0

@export independent = effect.apply
  (effect.map (\first%1 second%2 -> { first: first%1, second: second%2 }) firstAction)
  independentAction

@export pureValue = effect.pure 42
