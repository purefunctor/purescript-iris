---
source: tests-integration/src/fixtures.rs
---
@export whenConfigured = \configuration%0 reference%1 ->
  effect.when configuration%0.enabled (reference.write.unit reference%1 configuration%0.value)

@export unlessConfigured = \configuration%2 reference%3 ->
  effect.when
    (boolean.not configuration%2.enabled)
    (reference.write.unit reference%3 configuration%2.value)

@export diagonal = \size%5 ->
  effect.bind (reference.new 0)
    \count%4 -> effect.bind (effect.forRange
      0
      size%5
      (\row%6 ->
        effect.forRange
          0
          size%5
          (\column%7 ->
            effect.when
              (integer.equal row%6 column%7)
              (effect.bind (reference.read count%4)
                \section152%8 -> reference.write.unit count%4 (integer.add section152%8 1)))))
      \$unit%9 -> reference.read count%4

@export genericWhen = \applicativeEffectDict%10 -> when applicativeEffectDict%10
