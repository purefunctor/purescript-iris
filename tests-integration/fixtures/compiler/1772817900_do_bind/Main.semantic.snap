data Tuple :: Prim.Type -> Prim.Type -> Prim.Type
data Tuple @a @b
  | Tuple :: a -> b -> Main.Tuple a b

foreign import pure :: forall a. a -> Main.Effect a

foreign import bind :: forall a b. Main.Effect a -> (a -> Main.Effect b) -> Main.Effect b

foreign import discard :: forall a b. Main.Effect a -> (a -> Main.Effect b) -> Main.Effect b

test :: Main.Effect (Main.Tuple Prim.Int Prim.Int)
test = bind (pure 1) \x -> bind (pure 2) \y -> pure (Tuple x y)

test' :: Main.Effect (Main.Tuple Prim.Int Prim.Int)
test' = bind (pure 1) \x -> bind (pure 2) \y -> pure (Tuple x y)
