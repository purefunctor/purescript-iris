data Either :: Prim.Type -> Prim.Type -> Prim.Type
data Either @a @b
  | Left :: a -> Main.Either a b
  | Right :: b -> Main.Either a b

newtype EitherAlias :: Prim.Type -> Prim.Type -> Prim.Type
newtype EitherAlias @a @b
  | EitherAlias :: Main.Either a b -> Main.EitherAlias a b

coerceContainer :: Main.Container @(Prim.Type -> Prim.Type -> Prim.Type) Main.Either ->
