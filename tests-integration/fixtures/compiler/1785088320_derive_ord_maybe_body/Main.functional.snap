@export constructor Nothing/0

@export constructor Just/1

@export instance eqMaybe = \eqADict%0 ->
  {
    eq:
      \left%1 right%2 ->
        case left%1, right%2 of
          Nothing, Nothing ->
            true
          Just left0%3, Just right0%4 ->
            if eq eqADict%0 left0%3 right0%4 then true else false
          _, _ ->
            false
  }

@export instance ordMaybe = \ordADict%5 ->
  {
    "Eq0": \() -> eqMaybe (ordADict%5."Eq0"()),
    compare:
      \left%6 right%7 ->
        case left%6, right%7 of
          Nothing, Nothing ->
            "EQ"
          Nothing, _ ->
            "LT"
          _, Nothing ->
            "GT"
          Just left0%8, Just right0%9 ->
            case compare ordADict%5 left0%8 right0%9 of
              EQ ->
                "EQ"
              ordering%10 ->
                ordering%10
  }
