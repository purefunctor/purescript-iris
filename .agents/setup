#!/usr/bin/env bash
set -euo pipefail

export PATH="$HOME/.nix-profile/bin:$PATH"
export NIX_CONFIG="extra-experimental-features = nix-command flakes"
if ! command -v nix > /dev/null; then
  echo '--- Installing Nix'
  curl --proto '=https' --tlsv1.2 -fsSL https://nixos.org/nix/install | sh -s -- --no-daemon
fi

echo '--- Building the development shell'
state_directory="$HOME/.local/state/iris"
mkdir -p "$state_directory"
nix print-dev-env --profile "$state_directory/development-shell" --json > "$state_directory/development-shell.json"

jq -r '
  def sandbox_only: IN("HOME", "PATH", "SHELL", "CONFIG_SHELL", "HOST_PATH", "TERM", "TZ", "OLDPWD",
    "SOURCE_DATE_EPOCH", "NIX_BUILD_TOP", "NIX_BUILD_CORES", "NIX_LOG_FD", "NIX_ENFORCE_PURITY",
    "TMP", "TMPDIR", "TEMP", "TEMPDIR");
  .variables
  | "iris_nix_path=\(.PATH.value | @sh)",
    "case \"$PATH\" in",
    "  \"$iris_nix_path\" | \"$iris_nix_path\":*) ;;",
    "  *) PATH=\"$iris_nix_path${PATH:+:$PATH}\" ;;",
    "esac",
    "export PATH",
    "unset iris_nix_path",
    (to_entries[]
      | select(.value.type == "exported" and (.key | test("^[A-Z][A-Z0-9_]*$")) and (.key | sandbox_only | not))
      | "export \(.key)=\(.value.value | @sh)"),
    .shellHook.value
' "$state_directory/development-shell.json" | sudo tee /etc/profile.d/iris-nix.sh > /dev/null

hook='[ ! -r /etc/profile.d/iris-nix.sh ] || . /etc/profile.d/iris-nix.sh'
append_hook_last() {
  local startup_file="$1"
  shift
  local contents
  contents="$(grep -vFx "$hook" "$startup_file" 2> /dev/null || true)"
  printf '%s\n\n%s\n' "$contents" "$hook" | "$@" tee "$startup_file" > /dev/null
}
append_hook_last /etc/bash.bashrc sudo
for startup_file in "$HOME/.bashrc" "$HOME/.profile" "$HOME/.bash_profile"; do
  append_hook_last "$startup_file" env
done

. /etc/profile.d/iris-nix.sh
rustc --version
node --version

printf '\nSetup complete in %ss.\n' "$SECONDS"
