#!/usr/bin/env bash
set -euo pipefail

mise_version=2026.9.3
export PATH="$HOME/.local/bin:$PATH"
if [[ "$("$HOME/.local/bin/mise" version 2>/dev/null | cut -d' ' -f1 || true)" != "$mise_version" ]]; then
  echo '--- Installing mise'
  curl --proto '=https' --tlsv1.2 -fsSL https://mise.run \
    | MISE_VERSION="$mise_version" sh
fi

echo '--- Installing configured development tools'
mise trust mise.toml
mise install --yes
eval "$(mise env --shell bash)"
mise ls --current
rustup override set --path "$PWD" "$RUSTUP_TOOLCHAIN"

repository_root="$PWD"
sudo tee /etc/profile.d/iris-mise.sh > /dev/null <<EOF
if [ -z "\${iris_mise_environment_loaded-}" ] && [ -x "$HOME/.local/bin/mise" ]; then
  eval "\$("$HOME/.local/bin/mise" --cd "$repository_root" env --shell bash)"
  iris_mise_environment_loaded=1
fi
EOF

bashrc_hook='[ ! -r /etc/profile.d/iris-mise.sh ] || . /etc/profile.d/iris-mise.sh'
if ! grep -Fqx "$bashrc_hook" /etc/bash.bashrc; then
  printf '\n%s\n' "$bashrc_hook" | sudo tee -a /etc/bash.bashrc > /dev/null
fi

printf '\nSetup complete in %ss.\n' "$SECONDS"
